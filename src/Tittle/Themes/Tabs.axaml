<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    x:CompileBindings="False">

  <!-- Quiet rounded workspace tab. Applied to the tab-strip ListBox via
       ItemContainerTheme; replaces FluentAvalonia's large default TabItem look.
       The tab header comes from ListBox.ItemTemplate (DocumentTabViewModel.Header);
       this theme adds the hover/selected chrome, close button, and keyboard focus ring. -->
  <ControlTheme x:Key="VsCodeTab" TargetType="ListBoxItem">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource ChromeForegroundMutedBrush}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border x:Name="PART_Bg" Background="{TemplateBinding Background}"
                BorderBrush="Transparent" BorderThickness="1" CornerRadius="6" Margin="2,3">
          <Border.Transitions>
            <!-- Smooth hover/select recolor (= DurFast token). -->
            <Transitions>
              <BrushTransition Property="Background" Duration="{DynamicResource DurFast}" />
              <BrushTransition Property="BorderBrush" Duration="{DynamicResource DurFast}" />
            </Transitions>
          </Border.Transitions>
          <Grid ColumnDefinitions="*,Auto" Height="30" MinWidth="92">
            <ContentPresenter Grid.Column="0"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              VerticalAlignment="Center" Margin="12,0,4,0" />
            <!-- Close (✕): hidden until the tab is hovered or selected. -->
            <Button x:Name="PART_Close" Grid.Column="1"
                    FontSize="10" Width="18" Height="18" Padding="0" Margin="2,0,8,0"
                    VerticalAlignment="Center" Opacity="0"
                    ToolTip.Tip="Закрыть вкладку (Ctrl+W)"
                    AutomationProperties.AutomationId="CloseTabButton"
                    AutomationProperties.Name="Закрыть вкладку"
                    Background="Transparent" BorderThickness="0"
                    Command="{Binding $parent[ListBox].DataContext.CloseTabCommand}"
                    CommandParameter="{Binding}">
              <PathIcon Data="{StaticResource IconClose}" Width="9" Height="9"/>
              <Button.Transitions>
                <!-- Fade the ✕ in/out on hover (= DurFast token). -->
                <Transitions>
                  <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
                </Transitions>
              </Button.Transitions>
            </Button>
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:pointerover /template/ Border#PART_Bg">
      <Setter Property="Background" Value="{DynamicResource WorkspaceHoverBrush}" />
    </Style>
    <Style Selector="^:pointerover /template/ Button#PART_Close">
      <Setter Property="Opacity" Value="1" />
    </Style>

    <Style Selector="^:selected">
      <Setter Property="Foreground" Value="{DynamicResource ChromeForegroundBrush}" />
    </Style>
    <Style Selector="^:selected /template/ Border#PART_Bg">
      <Setter Property="Background" Value="{DynamicResource TabActiveBgBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource WorkspaceSeparatorBrush}" />
    </Style>
    <Style Selector="^:focus-visible /template/ Border#PART_Bg">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="^:selected /template/ Button#PART_Close">
      <Setter Property="Opacity" Value="1" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
