<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============ Gruvbox Light (ported, light family) ============
         Warm cream base, burnt-orange accent. Inherits the Light variant — only surface/chrome/
         accent tokens here; admonitions, cv-* decorations etc. fall back to Light.axaml. -->

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#FBF1C7" />
    <SolidColorBrush x:Key="EditorSurfaceBrush" Color="#FEFAE6" />
    <SolidColorBrush x:Key="SidebarSurfaceBrush" Color="#F2E5BC" />

    <LinearGradientBrush x:Key="ChromeBackgroundBrush" StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Color="#F7ECC0" Offset="0" />
        <GradientStop Color="#F2E5BC" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="ChromeOverlayBrush" Color="#F2E5BC" Opacity="0.72" />
    <SolidColorBrush x:Key="ChromeBorderBrush" Color="#D5C4A1" />
    <SolidColorBrush x:Key="ChromeForegroundBrush" Color="#3C3836" />
    <Color x:Key="ChromeForegroundColor">#3C3836</Color>
    <SolidColorBrush x:Key="ChromeForegroundMutedBrush" Color="#665C54" />

    <SolidColorBrush x:Key="AccentBrush" Color="#AF3A03" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#C44A0E" />

    <SolidColorBrush x:Key="StatusBarBackgroundBrush" Color="#EFE2B4" />
    <SolidColorBrush x:Key="StatusBarForegroundBrush" Color="#665C54" />


    <!-- Menu surfaces. A SUBMENU is drawn by an unnamed Border inside the MenuItem template that reads
         these RESOURCE keys, so no selector can reach it (Themes/Menus.axaml styles everything that a
         selector CAN reach). Kept equal to EditorSurfaceBrush / ChromeBorderBrush above so a submenu
         matches its parent flyout and the chrome; ThemeMenuResourceTests guards the pair from drifting. -->
    <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="#FEFAE6" />
    <SolidColorBrush x:Key="MenuFlyoutPresenterBorderBrush" Color="#D5C4A1" />

    <!-- Workspace shell + document tints, derived from THIS theme's own Window/Editor/Border/Accent so the
         whole app reads in one hue. They used to be absent here and fell through to Dark's neutral greys,
         which put a grey band (tab strip / header) and grey panels inside a tinted app.
         EveryTintedTheme_TintsItsShell guards that from coming back. -->
    <SolidColorBrush x:Key="WorkspaceRailBackgroundBrush" Color="#EEE5BD" />
    <SolidColorBrush x:Key="WorkspaceSidebarBackgroundBrush" Color="#FCF6D6" />
    <SolidColorBrush x:Key="WorkspaceHeaderBackgroundBrush" Color="#F0E6BE" />
    <SolidColorBrush x:Key="WorkspaceHoverBrush" Color="#DFD6B1" />
    <SolidColorBrush x:Key="WorkspaceSelectedBrush" Color="#E2C095" />
    <SolidColorBrush x:Key="WorkspaceSeparatorBrush" Color="#D5C4A1" />
    <SolidColorBrush x:Key="InlineCodeBgBrush" Color="#ECE8D6" />
    <SolidColorBrush x:Key="TableHeaderBgBrush" Color="#F6E7CF" />
    <SolidColorBrush x:Key="TableRowAltBgBrush" Color="#F5F1DE" />
    <SolidColorBrush x:Key="TableBorderBrush" Color="#DFD2B2" />
</ResourceDictionary>
