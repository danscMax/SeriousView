<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============ Nord (ported) ============
         Arctic blue-grey. Inherits the Dark variant: only surface/chrome/accent tokens are
         overridden — admonitions, cv-* decorations etc. fall back to Dark.axaml. -->

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#272B34" />
    <SolidColorBrush x:Key="EditorSurfaceBrush" Color="#2E3440" />
    <SolidColorBrush x:Key="SidebarSurfaceBrush" Color="#353C49" />

    <LinearGradientBrush x:Key="ChromeBackgroundBrush" StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Color="#434C5E" Offset="0" />
        <GradientStop Color="#3B4252" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="ChromeOverlayBrush" Color="#3B4252" Opacity="0.72" />
    <SolidColorBrush x:Key="ChromeBorderBrush" Color="#4C566A" />
    <SolidColorBrush x:Key="ChromeForegroundBrush" Color="#ECEFF4" />
    <Color x:Key="ChromeForegroundColor">#ECEFF4</Color>
    <SolidColorBrush x:Key="ChromeForegroundMutedBrush" Color="#9AA7BE" />

    <SolidColorBrush x:Key="AccentBrush" Color="#88C0D0" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#A3CDDA" />

    <SolidColorBrush x:Key="StatusBarBackgroundBrush" Color="#2A303B" />
    <SolidColorBrush x:Key="StatusBarForegroundBrush" Color="#A9B4C6" />


    <!-- Menu surfaces. A SUBMENU is drawn by an unnamed Border inside the MenuItem template that reads
         these RESOURCE keys, so no selector can reach it (Themes/Menus.axaml styles everything that a
         selector CAN reach). Kept equal to EditorSurfaceBrush / ChromeBorderBrush above so a submenu
         matches its parent flyout and the chrome; ThemeMenuResourceTests guards the pair from drifting. -->
    <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="#2E3440" />
    <SolidColorBrush x:Key="MenuFlyoutPresenterBorderBrush" Color="#4C566A" />

    <!-- Workspace shell + document tints, derived from THIS theme's own Window/Editor/Border/Accent so the
         whole app reads in one hue. They used to be absent here and fell through to Dark's neutral greys,
         which put a grey band (tab strip / header) and grey panels inside a tinted app.
         EveryTintedTheme_TintsItsShell guards that from coming back. -->
    <SolidColorBrush x:Key="WorkspaceRailBackgroundBrush" Color="#191C22" />
    <SolidColorBrush x:Key="WorkspaceSidebarBackgroundBrush" Color="#2A303A" />
    <SolidColorBrush x:Key="WorkspaceHeaderBackgroundBrush" Color="#31353D" />
    <SolidColorBrush x:Key="WorkspaceHoverBrush" Color="#3F434B" />
    <SolidColorBrush x:Key="WorkspaceSelectedBrush" Color="#44545D" />
    <SolidColorBrush x:Key="WorkspaceSeparatorBrush" Color="#4C566A" />
    <SolidColorBrush x:Key="InlineCodeBgBrush" Color="#3D424D" />
    <SolidColorBrush x:Key="TableHeaderBgBrush" Color="#37424E" />
    <SolidColorBrush x:Key="TableRowAltBgBrush" Color="#353B47" />
    <SolidColorBrush x:Key="TableBorderBrush" Color="#444E60" />
</ResourceDictionary>
