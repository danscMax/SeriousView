<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============ Midnight (ported dark set) ============
         A near-black, cool variant. Inherits the Dark variant: only the surface tokens are
         overridden here — admonitions, cv-* decorations etc. fall back to Dark.axaml. -->

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#0A0A0E" />
    <SolidColorBrush x:Key="EditorSurfaceBrush" Color="#0F0F14" />
    <!-- Opaque outline-sidebar surface (see Dark.axaml). -->
    <SolidColorBrush x:Key="SidebarSurfaceBrush" Color="#121219" />

    <LinearGradientBrush x:Key="ChromeBackgroundBrush" StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Color="#1B1B24" Offset="0" />
        <GradientStop Color="#14141B" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="ChromeOverlayBrush" Color="#15151D" Opacity="0.72" />
    <SolidColorBrush x:Key="ChromeBorderBrush" Color="#262630" />
    <SolidColorBrush x:Key="ChromeForegroundBrush" Color="#DEDEE9" />
    <Color x:Key="ChromeForegroundColor">#DEDEE9</Color>
    <SolidColorBrush x:Key="ChromeForegroundMutedBrush" Color="#8A8A9A" />

    <SolidColorBrush x:Key="AccentBrush" Color="#7AA2F7" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#93B4FF" />

    <SolidColorBrush x:Key="StatusBarBackgroundBrush" Color="#101017" />
    <SolidColorBrush x:Key="StatusBarForegroundBrush" Color="#A6A6B8" />


    <!-- Menu surfaces. A SUBMENU is drawn by an unnamed Border inside the MenuItem template that reads
         these RESOURCE keys, so no selector can reach it (Themes/Menus.axaml styles everything that a
         selector CAN reach). Kept equal to EditorSurfaceBrush / ChromeBorderBrush above so a submenu
         matches its parent flyout and the chrome; ThemeMenuResourceTests guards the pair from drifting. -->
    <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="#0F0F14" />
    <SolidColorBrush x:Key="MenuFlyoutPresenterBorderBrush" Color="#262630" />

    <!-- Workspace shell + document tints, derived from THIS theme's own Window/Editor/Border/Accent so the
         whole app reads in one hue. They used to be absent here and fell through to Dark's neutral greys,
         which put a grey band (tab strip / header) and grey panels inside a tinted app.
         EveryTintedTheme_TintsItsShell guards that from coming back. -->
    <SolidColorBrush x:Key="WorkspaceRailBackgroundBrush" Color="#060609" />
    <SolidColorBrush x:Key="WorkspaceSidebarBackgroundBrush" Color="#0C0C11" />
    <SolidColorBrush x:Key="WorkspaceHeaderBackgroundBrush" Color="#151519" />
    <SolidColorBrush x:Key="WorkspaceHoverBrush" Color="#252529" />
    <SolidColorBrush x:Key="WorkspaceSelectedBrush" Color="#2B344A" />
    <SolidColorBrush x:Key="WorkspaceSeparatorBrush" Color="#262630" />
    <SolidColorBrush x:Key="InlineCodeBgBrush" Color="#202024" />
    <SolidColorBrush x:Key="TableHeaderBgBrush" Color="#1A1E2B" />
    <SolidColorBrush x:Key="TableRowAltBgBrush" Color="#17171C" />
    <SolidColorBrush x:Key="TableBorderBrush" Color="#202029" />
</ResourceDictionary>
