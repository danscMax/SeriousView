<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============ Light theme — premium palette (same keys as Dark.axaml) ============ -->

    <!-- Base surfaces -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F7F7FB" />
    <SolidColorBrush x:Key="EditorSurfaceBrush" Color="#FFFFFF" />
    <!-- Opaque outline-sidebar surface (see Dark.axaml). -->
    <SolidColorBrush x:Key="SidebarSurfaceBrush" Color="#F0EFF4" />

    <SolidColorBrush x:Key="WorkspaceRailBackgroundBrush" Color="#E9E8EE" />
    <SolidColorBrush x:Key="WorkspaceSidebarBackgroundBrush" Color="#F0EFF4" />
    <SolidColorBrush x:Key="WorkspaceHeaderBackgroundBrush" Color="#F4F3F7" />
    <SolidColorBrush x:Key="WorkspaceHoverBrush" Color="#E5E2ED" />
    <!-- Transparent-surface base for hover fades — see Dark.axaml. Light-at-alpha-0 so the fade stays
         light instead of sweeping through white; light variants inherit it. -->
    <SolidColorBrush x:Key="HoverFadeBaseBrush" Color="#E5E2ED" Opacity="0" />
    <SolidColorBrush x:Key="WorkspaceSelectedBrush" Color="#DED8F2" />
    <SolidColorBrush x:Key="WorkspaceSeparatorBrush" Color="#D8D6DE" />

    <!-- Flat chrome: hierarchy comes from semantic surfaces, not glossy gradients. -->
    <SolidColorBrush x:Key="ChromeBackgroundBrush" Color="#F0EFF4" />
    <SolidColorBrush x:Key="ChromeOverlayBrush" Color="#F0EFF4" Opacity="0.94" />
    <SolidColorBrush x:Key="ChromeBorderBrush" Color="#D8D6DE" />
    <SolidColorBrush x:Key="ChromeForegroundBrush" Color="#1B1B24" />
  <!-- Color twin for properties typed as Color, not IBrush (MathView.TextColor, M11). -->
  <Color x:Key="ChromeForegroundColor">#1B1B24</Color>
    <SolidColorBrush x:Key="ChromeForegroundMutedBrush" Color="#6B6B78" />

    <!-- Subtle hover overlay for outline (TOC) items (reads on the chrome sidebar). -->
    <SolidColorBrush x:Key="OutlineItemHoverBrush" Color="#000000" Opacity="0.06" />

    <!-- Accent -->
    <SolidColorBrush x:Key="AccentBrush" Color="#6C50D9" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#5C40C8" />
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#FFFFFF" />

    <!-- Active document tab: a quiet filled tile over the strip, without an underline. -->
    <SolidColorBrush x:Key="TabActiveBgBrush" Color="#FFFFFF" />

    <!-- Preview tables (override Markdown.Avalonia's pale grey header): a faint accent-tinted header,
         a barely-there zebra alt row, and a subtle grid line. Custom light themes inherit these. -->
    <SolidColorBrush x:Key="TableHeaderBgBrush" Color="#E7EEFB" />
    <SolidColorBrush x:Key="TableRowAltBgBrush" Color="#F4F6FB" />
    <SolidColorBrush x:Key="TableBorderBrush" Color="#D5D9E2" />

    <!-- Inline `code` pill: a faint grey chip over the white editor surface (GitHub/VS-Code look).
         Custom light themes inherit it. -->
    <SolidColorBrush x:Key="InlineCodeBgBrush" Color="#EDEDF2" />

    <!-- In-document search: amber wash behind every match (current one is outlined in the accent). -->
    <SolidColorBrush x:Key="SearchMatchBrush" Color="#F5B301" Opacity="0.42" />

    <!-- Status bar — muted chrome tone (sits with the title bar, not a screaming accent). -->
    <SolidColorBrush x:Key="StatusBarBackgroundBrush" Color="#F0EFF4" />
    <SolidColorBrush x:Key="StatusBarForegroundBrush" Color="#575360" />

    <!-- Admonitions / GitHub alerts (light): accent stripe (full colour) + subtle tint. -->
    <SolidColorBrush x:Key="AdmonitionNoteBrush" Color="#0969DA" />
    <SolidColorBrush x:Key="AdmonitionNoteBgBrush" Color="#0969DA" Opacity="0.10" />
    <SolidColorBrush x:Key="AdmonitionTipBrush" Color="#1A7F37" />
    <SolidColorBrush x:Key="AdmonitionTipBgBrush" Color="#1A7F37" Opacity="0.10" />
    <SolidColorBrush x:Key="AdmonitionImportantBrush" Color="#8250DF" />
    <SolidColorBrush x:Key="AdmonitionImportantBgBrush" Color="#8250DF" Opacity="0.10" />
    <SolidColorBrush x:Key="AdmonitionWarningBrush" Color="#9A6700" />
    <SolidColorBrush x:Key="AdmonitionWarningBgBrush" Color="#9A6700" Opacity="0.10" />
    <SolidColorBrush x:Key="AdmonitionCautionBrush" Color="#CF222E" />
    <SolidColorBrush x:Key="AdmonitionCautionBgBrush" Color="#CF222E" Opacity="0.10" />

    <!-- cv-* code-view token decorations (ported): foregrounds painted by CodeDecorationColorizer. -->
    <SolidColorBrush x:Key="CvTimestampBrush" Color="#8250DF" />
    <SolidColorBrush x:Key="CvUuidBrush" Color="#0E7490" />
    <SolidColorBrush x:Key="CvMacBrush" Color="#9A6700" />
    <SolidColorBrush x:Key="CvIpBrush" Color="#BC4C00" />
    <SolidColorBrush x:Key="CvEmailBrush" Color="#0969DA" />
    <SolidColorBrush x:Key="CvHashBrush" Color="#6E7781" />
    <SolidColorBrush x:Key="CvPathBrush" Color="#0550AE" />
    <SolidColorBrush x:Key="CvTodoBrush" Color="#CF222E" />
    <SolidColorBrush x:Key="CvLogBrush" Color="#953800" />
    <SolidColorBrush x:Key="CvEntityBrush" Color="#A21CAF" />
    <SolidColorBrush x:Key="CvUnitBrush" Color="#0969DA" />
    <SolidColorBrush x:Key="CvDateBrush" Color="#1A7F37" />

    <!-- Indent guides in the code view (ported): a whisper, not a stripe. -->
    <SolidColorBrush x:Key="IndentGuideBrush" Color="#1F2328" Opacity="0.12" />


    <!-- Menu surfaces. A SUBMENU is drawn by an unnamed Border inside the MenuItem template that reads
         these RESOURCE keys, so no selector can reach it (Themes/Menus.axaml styles everything that a
         selector CAN reach). Kept equal to EditorSurfaceBrush / ChromeBorderBrush above so a submenu
         matches its parent flyout and the chrome; ThemeMenuResourceTests guards the pair from drifting. -->
    <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="MenuFlyoutPresenterBorderBrush" Color="#D8D6DE" />
</ResourceDictionary>
