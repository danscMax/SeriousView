<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============ Dracula (ported) ============
         The classic purple-on-charcoal palette. Inherits the Dark variant — only surface/chrome/
         accent tokens here; admonitions, cv-* decorations etc. fall back to Dark.axaml. -->

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#282A36" />
    <SolidColorBrush x:Key="EditorSurfaceBrush" Color="#21222C" />
    <SolidColorBrush x:Key="SidebarSurfaceBrush" Color="#2D2F3D" />

    <LinearGradientBrush x:Key="ChromeBackgroundBrush" StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Color="#343746" Offset="0" />
        <GradientStop Color="#282A36" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="ChromeOverlayBrush" Color="#21222C" Opacity="0.72" />
    <SolidColorBrush x:Key="ChromeBorderBrush" Color="#44475A" />
    <SolidColorBrush x:Key="ChromeForegroundBrush" Color="#F8F8F2" />
    <Color x:Key="ChromeForegroundColor">#F8F8F2</Color>
    <SolidColorBrush x:Key="ChromeForegroundMutedBrush" Color="#9098C0" />

    <SolidColorBrush x:Key="AccentBrush" Color="#BD93F9" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#D0B0FF" />

    <SolidColorBrush x:Key="StatusBarBackgroundBrush" Color="#1E1F28" />
    <SolidColorBrush x:Key="StatusBarForegroundBrush" Color="#9FA6C4" />


    <!-- Menu surfaces. A SUBMENU is drawn by an unnamed Border inside the MenuItem template that reads
         these RESOURCE keys, so no selector can reach it (Themes/Menus.axaml styles everything that a
         selector CAN reach). Kept equal to EditorSurfaceBrush / ChromeBorderBrush above so a submenu
         matches its parent flyout and the chrome; ThemeMenuResourceTests guards the pair from drifting. -->
    <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="#21222C" />
    <SolidColorBrush x:Key="MenuFlyoutPresenterBorderBrush" Color="#44475A" />

    <!-- Workspace shell + document tints, derived from THIS theme's own Window/Editor/Border/Accent so the
         whole app reads in one hue. They used to be absent here and fell through to Dark's neutral greys,
         which put a grey band (tab strip / header) and grey panels inside a tinted app.
         EveryTintedTheme_TintsItsShell guards that from coming back. -->
    <SolidColorBrush x:Key="WorkspaceRailBackgroundBrush" Color="#1A1B23" />
    <SolidColorBrush x:Key="WorkspaceSidebarBackgroundBrush" Color="#242631" />
    <SolidColorBrush x:Key="WorkspaceHeaderBackgroundBrush" Color="#32343F" />
    <SolidColorBrush x:Key="WorkspaceHoverBrush" Color="#40424C" />
    <SolidColorBrush x:Key="WorkspaceSelectedBrush" Color="#514968" />
    <SolidColorBrush x:Key="WorkspaceSeparatorBrush" Color="#44475A" />
    <SolidColorBrush x:Key="InlineCodeBgBrush" Color="#31313B" />
    <SolidColorBrush x:Key="TableHeaderBgBrush" Color="#312D40" />
    <SolidColorBrush x:Key="TableRowAltBgBrush" Color="#292A33" />
    <SolidColorBrush x:Key="TableBorderBrush" Color="#3B3E4E" />
</ResourceDictionary>
