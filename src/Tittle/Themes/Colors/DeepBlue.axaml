<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============ Deep Blue (ported dark set) ============
         A deep navy/indigo variant (VS-Code "Tokyo Night" feel). Inherits the Dark variant: only the
         surface + chrome + accent tokens are overridden here; admonitions, cv-* decorations etc. fall
         back to Dark.axaml. The reading area is WindowBackgroundBrush (preview is transparent over it),
         the source/CSV/notice surface is EditorSurfaceBrush — so the whole app reads deep blue. -->

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#10131C" />
    <SolidColorBrush x:Key="EditorSurfaceBrush" Color="#14161C" />
    <SolidColorBrush x:Key="SidebarSurfaceBrush" Color="#1A1E2A" />

    <LinearGradientBrush x:Key="ChromeBackgroundBrush" StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Color="#26335A" Offset="0" />
        <GradientStop Color="#1A2440" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="ChromeOverlayBrush" Color="#1D294A" Opacity="0.72" />
    <SolidColorBrush x:Key="ChromeBorderBrush" Color="#33446E" />
    <SolidColorBrush x:Key="ChromeForegroundBrush" Color="#C8D3F5" />
    <Color x:Key="ChromeForegroundColor">#C8D3F5</Color>
    <SolidColorBrush x:Key="ChromeForegroundMutedBrush" Color="#7E8CBE" />

    <SolidColorBrush x:Key="AccentBrush" Color="#7AA2F7" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#9AB8FF" />

    <!-- Active document tab: a gentle navy LIFT over the tab strip (not the near-black editor surface,
         which read as an ugly black box). Marked further by the accent underline + bright text. -->
    <SolidColorBrush x:Key="TabActiveBgBrush" Color="#243456" />

    <SolidColorBrush x:Key="StatusBarBackgroundBrush" Color="#121728" />
    <SolidColorBrush x:Key="StatusBarForegroundBrush" Color="#98A4D2" />


    <!-- Menu surfaces. A SUBMENU is drawn by an unnamed Border inside the MenuItem template that reads
         these RESOURCE keys, so no selector can reach it (Themes/Menus.axaml styles everything that a
         selector CAN reach). Kept equal to EditorSurfaceBrush / ChromeBorderBrush above so a submenu
         matches its parent flyout and the chrome; ThemeMenuResourceTests guards the pair from drifting. -->
    <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="#14161C" />
    <SolidColorBrush x:Key="MenuFlyoutPresenterBorderBrush" Color="#33446E" />

    <!-- Workspace shell + document tints, derived from THIS theme's own Window/Editor/Border/Accent so the
         whole app reads in one hue. They used to be absent here and fell through to Dark's neutral greys,
         which put a grey band (tab strip / header) and grey panels inside a tinted app.
         EveryTintedTheme_TintsItsShell guards that from coming back. -->
    <SolidColorBrush x:Key="WorkspaceRailBackgroundBrush" Color="#0A0C12" />
    <SolidColorBrush x:Key="WorkspaceSidebarBackgroundBrush" Color="#12141C" />
    <SolidColorBrush x:Key="WorkspaceHeaderBackgroundBrush" Color="#1B1E26" />
    <SolidColorBrush x:Key="WorkspaceHoverBrush" Color="#2B2E35" />
    <SolidColorBrush x:Key="WorkspaceSelectedBrush" Color="#303B54" />
    <SolidColorBrush x:Key="WorkspaceSeparatorBrush" Color="#33446E" />
    <SolidColorBrush x:Key="InlineCodeBgBrush" Color="#24262C" />
    <SolidColorBrush x:Key="TableHeaderBgBrush" Color="#1E2432" />
    <SolidColorBrush x:Key="TableRowAltBgBrush" Color="#1C1E24" />
    <SolidColorBrush x:Key="TableBorderBrush" Color="#2B385A" />
</ResourceDictionary>
