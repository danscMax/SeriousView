<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============ Solarized Dark (ported) ============
         Ethan Schoonover's deep teal base. Inherits the Dark variant — only surface/chrome/accent
         tokens here; admonitions, cv-* decorations etc. fall back to Dark.axaml. -->

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#002B36" />
    <SolidColorBrush x:Key="EditorSurfaceBrush" Color="#073642" />
    <SolidColorBrush x:Key="SidebarSurfaceBrush" Color="#093F4C" />

    <LinearGradientBrush x:Key="ChromeBackgroundBrush" StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Color="#0A4250" Offset="0" />
        <GradientStop Color="#073642" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="ChromeOverlayBrush" Color="#073642" Opacity="0.72" />
    <SolidColorBrush x:Key="ChromeBorderBrush" Color="#0E4954" />
    <SolidColorBrush x:Key="ChromeForegroundBrush" Color="#B6C2C2" />
    <Color x:Key="ChromeForegroundColor">#B6C2C2</Color>
    <SolidColorBrush x:Key="ChromeForegroundMutedBrush" Color="#99A7A9" />

    <SolidColorBrush x:Key="AccentBrush" Color="#B58900" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#D0A020" />

    <SolidColorBrush x:Key="StatusBarBackgroundBrush" Color="#04323D" />
    <SolidColorBrush x:Key="StatusBarForegroundBrush" Color="#8A9A9C" />


    <!-- Menu surfaces. A SUBMENU is drawn by an unnamed Border inside the MenuItem template that reads
         these RESOURCE keys, so no selector can reach it (Themes/Menus.axaml styles everything that a
         selector CAN reach). Kept equal to EditorSurfaceBrush / ChromeBorderBrush above so a submenu
         matches its parent flyout and the chrome; ThemeMenuResourceTests guards the pair from drifting. -->
    <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="#073642" />
    <SolidColorBrush x:Key="MenuFlyoutPresenterBorderBrush" Color="#0E4954" />

    <!-- Workspace shell + document tints, derived from THIS theme's own Window/Editor/Border/Accent so the
         whole app reads in one hue. They used to be absent here and fell through to Dark's neutral greys,
         which put a grey band (tab strip / header) and grey panels inside a tinted app.
         EveryTintedTheme_TintsItsShell guards that from coming back. -->
    <SolidColorBrush x:Key="WorkspaceRailBackgroundBrush" Color="#001C23" />
    <SolidColorBrush x:Key="WorkspaceSidebarBackgroundBrush" Color="#04303C" />
    <SolidColorBrush x:Key="WorkspaceHeaderBackgroundBrush" Color="#0B353F" />
    <SolidColorBrush x:Key="WorkspaceHoverBrush" Color="#1C434C" />
    <SolidColorBrush x:Key="WorkspaceSelectedBrush" Color="#304731" />
    <SolidColorBrush x:Key="WorkspaceSeparatorBrush" Color="#0E4954" />
    <SolidColorBrush x:Key="InlineCodeBgBrush" Color="#18444F" />
    <SolidColorBrush x:Key="TableHeaderBgBrush" Color="#183E3B" />
    <SolidColorBrush x:Key="TableRowAltBgBrush" Color="#103D49" />
    <SolidColorBrush x:Key="TableBorderBrush" Color="#0C4450" />
</ResourceDictionary>
