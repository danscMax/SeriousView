<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============ Solarized Dim (ported) ============
         A muted mid-tone between Solarized Light and Dark. Inherits the Dark variant — only
         surface/chrome/accent tokens here; the rest falls back to Dark.axaml. -->

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#1C2A2F" />
    <SolidColorBrush x:Key="EditorSurfaceBrush" Color="#16242A" />
    <SolidColorBrush x:Key="SidebarSurfaceBrush" Color="#1E3038" />

    <LinearGradientBrush x:Key="ChromeBackgroundBrush" StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Color="#243840" Offset="0" />
        <GradientStop Color="#1C2A2F" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="ChromeOverlayBrush" Color="#16242A" Opacity="0.72" />
    <SolidColorBrush x:Key="ChromeBorderBrush" Color="#2A3D44" />
    <SolidColorBrush x:Key="ChromeForegroundBrush" Color="#AFBDBD" />
    <Color x:Key="ChromeForegroundColor">#AFBDBD</Color>
    <SolidColorBrush x:Key="ChromeForegroundMutedBrush" Color="#8C9B9B" />

    <SolidColorBrush x:Key="AccentBrush" Color="#268BD2" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#4AA8E0" />

    <SolidColorBrush x:Key="StatusBarBackgroundBrush" Color="#142026" />
    <SolidColorBrush x:Key="StatusBarForegroundBrush" Color="#829292" />


    <!-- Menu surfaces. A SUBMENU is drawn by an unnamed Border inside the MenuItem template that reads
         these RESOURCE keys, so no selector can reach it (Themes/Menus.axaml styles everything that a
         selector CAN reach). Kept equal to EditorSurfaceBrush / ChromeBorderBrush above so a submenu
         matches its parent flyout and the chrome; ThemeMenuResourceTests guards the pair from drifting. -->
    <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="#16242A" />
    <SolidColorBrush x:Key="MenuFlyoutPresenterBorderBrush" Color="#2A3D44" />

    <!-- Workspace shell + document tints, derived from THIS theme's own Window/Editor/Border/Accent so the
         whole app reads in one hue. They used to be absent here and fell through to Dark's neutral greys,
         which put a grey band (tab strip / header) and grey panels inside a tinted app.
         EveryTintedTheme_TintsItsShell guards that from coming back. -->
    <SolidColorBrush x:Key="WorkspaceRailBackgroundBrush" Color="#121B1F" />
    <SolidColorBrush x:Key="WorkspaceSidebarBackgroundBrush" Color="#19272C" />
    <SolidColorBrush x:Key="WorkspaceHeaderBackgroundBrush" Color="#263438" />
    <SolidColorBrush x:Key="WorkspaceHoverBrush" Color="#354246" />
    <SolidColorBrush x:Key="WorkspaceSelectedBrush" Color="#26475A" />
    <SolidColorBrush x:Key="WorkspaceSeparatorBrush" Color="#2A3D44" />
    <SolidColorBrush x:Key="InlineCodeBgBrush" Color="#263339" />
    <SolidColorBrush x:Key="TableHeaderBgBrush" Color="#182E3B" />
    <SolidColorBrush x:Key="TableRowAltBgBrush" Color="#1E2C31" />
    <SolidColorBrush x:Key="TableBorderBrush" Color="#25373E" />
</ResourceDictionary>
