<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============ Gruvbox Dark (ported) ============
         Warm retro palette, amber accent. Inherits the Dark variant — only surface/chrome/accent
         tokens here; admonitions, cv-* decorations etc. fall back to Dark.axaml. -->

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#282828" />
    <SolidColorBrush x:Key="EditorSurfaceBrush" Color="#32302F" />
    <SolidColorBrush x:Key="SidebarSurfaceBrush" Color="#3A3735" />

    <LinearGradientBrush x:Key="ChromeBackgroundBrush" StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Color="#3C3836" Offset="0" />
        <GradientStop Color="#32302F" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="ChromeOverlayBrush" Color="#32302F" Opacity="0.72" />
    <SolidColorBrush x:Key="ChromeBorderBrush" Color="#504945" />
    <SolidColorBrush x:Key="ChromeForegroundBrush" Color="#EBDBB2" />
    <Color x:Key="ChromeForegroundColor">#EBDBB2</Color>
    <SolidColorBrush x:Key="ChromeForegroundMutedBrush" Color="#AFA18E" />

    <SolidColorBrush x:Key="AccentBrush" Color="#FABD2F" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#FFD05A" />

    <SolidColorBrush x:Key="StatusBarBackgroundBrush" Color="#242220" />
    <SolidColorBrush x:Key="StatusBarForegroundBrush" Color="#BDAE93" />


    <!-- Menu surfaces. A SUBMENU is drawn by an unnamed Border inside the MenuItem template that reads
         these RESOURCE keys, so no selector can reach it (Themes/Menus.axaml styles everything that a
         selector CAN reach). Kept equal to EditorSurfaceBrush / ChromeBorderBrush above so a submenu
         matches its parent flyout and the chrome; ThemeMenuResourceTests guards the pair from drifting. -->
    <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="#32302F" />
    <SolidColorBrush x:Key="MenuFlyoutPresenterBorderBrush" Color="#504945" />

    <!-- Workspace shell + document tints, derived from THIS theme's own Window/Editor/Border/Accent so the
         whole app reads in one hue. They used to be absent here and fell through to Dark's neutral greys,
         which put a grey band (tab strip / header) and grey panels inside a tinted app.
         EveryTintedTheme_TintsItsShell guards that from coming back. -->
    <SolidColorBrush x:Key="WorkspaceRailBackgroundBrush" Color="#1A1A1A" />
    <SolidColorBrush x:Key="WorkspaceSidebarBackgroundBrush" Color="#2D2C2C" />
    <SolidColorBrush x:Key="WorkspaceHeaderBackgroundBrush" Color="#323232" />
    <SolidColorBrush x:Key="WorkspaceHoverBrush" Color="#404040" />
    <SolidColorBrush x:Key="WorkspaceSelectedBrush" Color="#5E5131" />
    <SolidColorBrush x:Key="WorkspaceSeparatorBrush" Color="#504945" />
    <SolidColorBrush x:Key="InlineCodeBgBrush" Color="#403E3E" />
    <SolidColorBrush x:Key="TableHeaderBgBrush" Color="#463E2F" />
    <SolidColorBrush x:Key="TableRowAltBgBrush" Color="#393736" />
    <SolidColorBrush x:Key="TableBorderBrush" Color="#484340" />
</ResourceDictionary>
