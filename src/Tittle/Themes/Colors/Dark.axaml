<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============ Dark theme — premium palette ============
         Referenced via {DynamicResource}; swaps instantly on theme change.
         *OverlayBrush = semi-transparent chrome (lets Mica/Acrylic show through, C8).
         EditorSurfaceBrush = solid backing under the editor (keeps code readable). -->

    <!-- Base surfaces -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#15151A" />
    <SolidColorBrush x:Key="EditorSurfaceBrush" Color="#1B1B22" />
    <!-- Opaque outline-sidebar surface (reproduces the old ChromeOverlay-over-window look, now solid so
         the single body reading-glow stays continuous across the sidebar/content seam). -->
    <SolidColorBrush x:Key="SidebarSurfaceBrush" Color="#1B1B1F" />

    <!-- Obsidian-inspired workspace hierarchy. These are semantic shell roles, kept separate from
         document surfaces so the shell can be redesigned without retinting the reader. -->
    <SolidColorBrush x:Key="WorkspaceRailBackgroundBrush" Color="#121216" />
    <SolidColorBrush x:Key="WorkspaceSidebarBackgroundBrush" Color="#1B1B1F" />
    <SolidColorBrush x:Key="WorkspaceHeaderBackgroundBrush" Color="#18181C" />
    <SolidColorBrush x:Key="WorkspaceHoverBrush" Color="#29282F" />
    <!-- Transparent-SURFACE base for hover fades. A hover overlay fades Background from its rest state to
         WorkspaceHover/ChromeOverlay; if the rest state is `Transparent` (= #00FFFFFF, transparent WHITE)
         the BrushTransition lerps RGB through white while alpha ramps → a white flash before the dark
         overlay settles. Fading from this dark-at-alpha-0 brush keeps the whole sweep dark. Dark variants
         inherit it (all have dark surfaces); Light.axaml restates it light. -->
    <SolidColorBrush x:Key="HoverFadeBaseBrush" Color="#29282F" Opacity="0" />
    <SolidColorBrush x:Key="WorkspaceSelectedBrush" Color="#35303F" />
    <SolidColorBrush x:Key="WorkspaceSeparatorBrush" Color="#303036" />

    <!-- Flat chrome: hierarchy comes from semantic surfaces, not glossy gradients. -->
    <SolidColorBrush x:Key="ChromeBackgroundBrush" Color="#1B1B1F" />
    <SolidColorBrush x:Key="ChromeOverlayBrush" Color="#1B1B1F" Opacity="0.94" />
    <SolidColorBrush x:Key="ChromeBorderBrush" Color="#303036" />
    <SolidColorBrush x:Key="ChromeForegroundBrush" Color="#E8E7EC" />
  <!-- Color twin for properties typed as Color, not IBrush (MathView.TextColor, M11). -->
  <Color x:Key="ChromeForegroundColor">#E8E7EC</Color>
    <SolidColorBrush x:Key="ChromeForegroundMutedBrush" Color="#AAA8B2" />

    <!-- Subtle hover overlay for outline (TOC) items (reads on the chrome sidebar). -->
    <SolidColorBrush x:Key="OutlineItemHoverBrush" Color="#FFFFFF" Opacity="0.07" />

    <!-- Accent -->
    <SolidColorBrush x:Key="AccentBrush" Color="#8B79F7" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#A18FFF" />
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#FFFFFF" />

    <!-- Active document tab: a quiet filled tile over the strip, without an underline. -->
    <SolidColorBrush x:Key="TabActiveBgBrush" Color="#35303F" />

    <!-- Preview tables (override Markdown.Avalonia's pale grey header): a faint accent-tinted header,
         a barely-there zebra alt row, and a subtle grid line. Custom dark themes inherit these. -->
    <SolidColorBrush x:Key="TableHeaderBgBrush" Color="#232C40" />
    <SolidColorBrush x:Key="TableRowAltBgBrush" Color="#202028" />
    <SolidColorBrush x:Key="TableBorderBrush" Color="#34343F" />

    <!-- Inline `code` pill: a faint lift over the editor surface (#1B1B22) so inline code reads as a
         chip (GitHub/VS-Code look) without shouting. Custom dark themes inherit it. -->
    <SolidColorBrush x:Key="InlineCodeBgBrush" Color="#2A2A33" />

    <!-- In-document search: amber wash behind every match (current one is outlined in the accent). -->
    <SolidColorBrush x:Key="SearchMatchBrush" Color="#E2B341" Opacity="0.33" />

    <!-- Status bar — muted chrome tone (sits with the title bar, not a screaming accent). -->
    <SolidColorBrush x:Key="StatusBarBackgroundBrush" Color="#18181C" />
    <SolidColorBrush x:Key="StatusBarForegroundBrush" Color="#BDBAC5" />

    <!-- Admonitions / GitHub alerts (dark): accent stripe (full colour) + subtle tint. -->
    <SolidColorBrush x:Key="AdmonitionNoteBrush" Color="#4493F8" />
    <SolidColorBrush x:Key="AdmonitionNoteBgBrush" Color="#4493F8" Opacity="0.12" />
    <SolidColorBrush x:Key="AdmonitionTipBrush" Color="#3FB950" />
    <SolidColorBrush x:Key="AdmonitionTipBgBrush" Color="#3FB950" Opacity="0.12" />
    <SolidColorBrush x:Key="AdmonitionImportantBrush" Color="#AB7DF8" />
    <SolidColorBrush x:Key="AdmonitionImportantBgBrush" Color="#AB7DF8" Opacity="0.12" />
    <SolidColorBrush x:Key="AdmonitionWarningBrush" Color="#D29922" />
    <SolidColorBrush x:Key="AdmonitionWarningBgBrush" Color="#D29922" Opacity="0.12" />
    <SolidColorBrush x:Key="AdmonitionCautionBrush" Color="#F85149" />
    <SolidColorBrush x:Key="AdmonitionCautionBgBrush" Color="#F85149" Opacity="0.12" />

    <!-- cv-* code-view token decorations (ported): foregrounds painted by CodeDecorationColorizer. -->
    <SolidColorBrush x:Key="CvTimestampBrush" Color="#D2A8FF" />
    <SolidColorBrush x:Key="CvUuidBrush" Color="#67E8F9" />
    <SolidColorBrush x:Key="CvMacBrush" Color="#D29922" />
    <SolidColorBrush x:Key="CvIpBrush" Color="#F0883E" />
    <SolidColorBrush x:Key="CvEmailBrush" Color="#58A6FF" />
    <SolidColorBrush x:Key="CvHashBrush" Color="#8B949E" />
    <SolidColorBrush x:Key="CvPathBrush" Color="#79C0FF" />
    <SolidColorBrush x:Key="CvTodoBrush" Color="#FF7B72" />
    <SolidColorBrush x:Key="CvLogBrush" Color="#FFA657" />
    <SolidColorBrush x:Key="CvEntityBrush" Color="#E879F9" />
    <SolidColorBrush x:Key="CvUnitBrush" Color="#58A6FF" />
    <SolidColorBrush x:Key="CvDateBrush" Color="#3FB950" />

    <!-- Indent guides in the code view (ported): a whisper, not a stripe. -->
    <SolidColorBrush x:Key="IndentGuideBrush" Color="#E7E7EF" Opacity="0.10" />


    <!-- Menu surfaces. A SUBMENU is drawn by an unnamed Border inside the MenuItem template that reads
         these RESOURCE keys, so no selector can reach it (Themes/Menus.axaml styles everything that a
         selector CAN reach). Kept equal to EditorSurfaceBrush / ChromeBorderBrush above so a submenu
         matches its parent flyout and the chrome; ThemeMenuResourceTests guards the pair from drifting. -->
    <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="#1B1B22" />
    <SolidColorBrush x:Key="MenuFlyoutPresenterBorderBrush" Color="#303036" />
</ResourceDictionary>
