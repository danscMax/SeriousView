<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============ Ocean (ported dark set) ============
         A deep blue-teal variant. Inherits the Dark variant: only the surface tokens are
         overridden here — admonitions, cv-* decorations etc. fall back to Dark.axaml. -->

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#0A0D12" />
    <SolidColorBrush x:Key="EditorSurfaceBrush" Color="#0D1116" />
    <!-- Opaque outline-sidebar surface (see Dark.axaml). -->
    <SolidColorBrush x:Key="SidebarSurfaceBrush" Color="#0F1318" />

    <LinearGradientBrush x:Key="ChromeBackgroundBrush" StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Color="#17252F" Offset="0" />
        <GradientStop Color="#121E28" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="ChromeOverlayBrush" Color="#14222C" Opacity="0.72" />
    <SolidColorBrush x:Key="ChromeBorderBrush" Color="#233442" />
    <SolidColorBrush x:Key="ChromeForegroundBrush" Color="#DCE7EF" />
    <Color x:Key="ChromeForegroundColor">#DCE7EF</Color>
    <SolidColorBrush x:Key="ChromeForegroundMutedBrush" Color="#8FA3B3" />

    <SolidColorBrush x:Key="AccentBrush" Color="#2EC8BE" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#4FD8CF" />

    <SolidColorBrush x:Key="StatusBarBackgroundBrush" Color="#0F1B25" />
    <SolidColorBrush x:Key="StatusBarForegroundBrush" Color="#A4BACA" />


    <!-- Menu surfaces. A SUBMENU is drawn by an unnamed Border inside the MenuItem template that reads
         these RESOURCE keys, so no selector can reach it (Themes/Menus.axaml styles everything that a
         selector CAN reach). Kept equal to EditorSurfaceBrush / ChromeBorderBrush above so a submenu
         matches its parent flyout and the chrome; ThemeMenuResourceTests guards the pair from drifting. -->
    <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="#0D1116" />
    <SolidColorBrush x:Key="MenuFlyoutPresenterBorderBrush" Color="#233442" />

    <!-- Workspace shell + document tints, derived from THIS theme's own Window/Editor/Border/Accent so the
         whole app reads in one hue. They used to be absent here and fell through to Dark's neutral greys,
         which put a grey band (tab strip / header) and grey panels inside a tinted app.
         EveryTintedTheme_TintsItsShell guards that from coming back. -->
    <SolidColorBrush x:Key="WorkspaceRailBackgroundBrush" Color="#06080C" />
    <SolidColorBrush x:Key="WorkspaceSidebarBackgroundBrush" Color="#0C0F14" />
    <SolidColorBrush x:Key="WorkspaceHeaderBackgroundBrush" Color="#15181D" />
    <SolidColorBrush x:Key="WorkspaceHoverBrush" Color="#25282D" />
    <SolidColorBrush x:Key="WorkspaceSelectedBrush" Color="#1A3F40" />
    <SolidColorBrush x:Key="WorkspaceSeparatorBrush" Color="#233442" />
    <SolidColorBrush x:Key="InlineCodeBgBrush" Color="#1E2226" />
    <SolidColorBrush x:Key="TableHeaderBgBrush" Color="#102327" />
    <SolidColorBrush x:Key="TableRowAltBgBrush" Color="#15191E" />
    <SolidColorBrush x:Key="TableBorderBrush" Color="#1E2B37" />
</ResourceDictionary>
