<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============ Sepia (ported, light family) ============
         Warm paper tone, brown accent. Inherits the Light variant — only surface/chrome/accent
         tokens here; admonitions, cv-* decorations etc. fall back to Light.axaml. -->

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F7F1E1" />
    <SolidColorBrush x:Key="EditorSurfaceBrush" Color="#FBF6E8" />
    <SolidColorBrush x:Key="SidebarSurfaceBrush" Color="#EFE6D0" />

    <LinearGradientBrush x:Key="ChromeBackgroundBrush" StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Color="#FBF7EC" Offset="0" />
        <GradientStop Color="#EFE6D0" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="ChromeOverlayBrush" Color="#EFE6D0" Opacity="0.72" />
    <SolidColorBrush x:Key="ChromeBorderBrush" Color="#DBCCAA" />
    <SolidColorBrush x:Key="ChromeForegroundBrush" Color="#5B4636" />
    <Color x:Key="ChromeForegroundColor">#5B4636</Color>
    <SolidColorBrush x:Key="ChromeForegroundMutedBrush" Color="#756150" />

    <SolidColorBrush x:Key="AccentBrush" Color="#8B4513" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#A0522D" />

    <SolidColorBrush x:Key="StatusBarBackgroundBrush" Color="#EAE0C8" />
    <SolidColorBrush x:Key="StatusBarForegroundBrush" Color="#735F4E" />


    <!-- Menu surfaces. A SUBMENU is drawn by an unnamed Border inside the MenuItem template that reads
         these RESOURCE keys, so no selector can reach it (Themes/Menus.axaml styles everything that a
         selector CAN reach). Kept equal to EditorSurfaceBrush / ChromeBorderBrush above so a submenu
         matches its parent flyout and the chrome; ThemeMenuResourceTests guards the pair from drifting. -->
    <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="#FBF6E8" />
    <SolidColorBrush x:Key="MenuFlyoutPresenterBorderBrush" Color="#DBCCAA" />

    <!-- Workspace shell + document tints, derived from THIS theme's own Window/Editor/Border/Accent so the
         whole app reads in one hue. They used to be absent here and fell through to Dark's neutral greys,
         which put a grey band (tab strip / header) and grey panels inside a tinted app.
         EveryTintedTheme_TintsItsShell guards that from coming back. -->
    <SolidColorBrush x:Key="WorkspaceRailBackgroundBrush" Color="#EBE5D6" />
    <SolidColorBrush x:Key="WorkspaceSidebarBackgroundBrush" Color="#F9F4E4" />
    <SolidColorBrush x:Key="WorkspaceHeaderBackgroundBrush" Color="#ECE6D7" />
    <SolidColorBrush x:Key="WorkspaceHoverBrush" Color="#DBD6C8" />
    <SolidColorBrush x:Key="WorkspaceSelectedBrush" Color="#D7C3AC" />
    <SolidColorBrush x:Key="WorkspaceSeparatorBrush" Color="#DBCCAA" />
    <SolidColorBrush x:Key="InlineCodeBgBrush" Color="#E9E5D8" />
    <SolidColorBrush x:Key="TableHeaderBgBrush" Color="#F0E4D3" />
    <SolidColorBrush x:Key="TableRowAltBgBrush" Color="#F2EDE0" />
    <SolidColorBrush x:Key="TableBorderBrush" Color="#E3D6BA" />
</ResourceDictionary>
