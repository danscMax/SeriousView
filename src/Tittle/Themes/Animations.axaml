<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Smooth recolor of chrome surfaces when the theme changes. -->
    <Style Selector="Border.chrome">
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="{DynamicResource DurBase}" />
                <BrushTransition Property="BorderBrush" Duration="{DynamicResource DurBase}" />
            </Transitions>
        </Setter>
    </Style>

</Styles>
