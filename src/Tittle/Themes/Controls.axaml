<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Modal card: the rounded, shadowed surface every standalone modal (ModalWindow + the command
       palette) draws its content on. Holds the shared chrome (the transparent window shape lives in
       ModalWindow's ctor); each window keeps only its own Padding. TextElement.Foreground sets the
       default text colour once via inheritance — muted labels and the accent button still override it
       (their own Foreground wins over the inherited default), so no per-control Foreground is needed. -->
  <Style Selector="Border.modalcard">
    <Setter Property="Background" Value="{DynamicResource EditorSurfaceBrush}"/>
    <Setter Property="CornerRadius" Value="14"/>
    <Setter Property="BorderBrush" Value="{DynamicResource ChromeBorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="BoxShadow" Value="{DynamicResource ChromeShadow}"/>
    <Setter Property="Margin" Value="12"/>
    <Setter Property="TextElement.Foreground" Value="{DynamicResource ChromeForegroundBrush}"/>
  </Style>
  <!-- Modal fields deliberately use the same quiet inset surface as the omnibar. This gives settings,
       palette and other dialogs a shared tactile vocabulary instead of each falling back to Fluent's
       high-contrast default field. -->
  <Style Selector="Border.modalcard TextBox, TextBox.modal-field">
    <Setter Property="MinHeight" Value="34"/>
    <Setter Property="Padding" Value="10,6"/>
    <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}"/>
    <Setter Property="Background" Value="{DynamicResource WorkspaceHeaderBackgroundBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource WorkspaceSeparatorBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="{DynamicResource DurFast}"/>
        <BrushTransition Property="BorderBrush" Duration="{DynamicResource DurFast}"/>
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Border.modalcard TextBox:pointerover, TextBox.modal-field:pointerover">
    <Setter Property="BorderBrush" Value="{DynamicResource ChromeBorderBrush}"/>
  </Style>
  <Style Selector="Border.modalcard TextBox:focus /template/ Border#PART_BorderElement,
                   TextBox.modal-field:focus /template/ Border#PART_BorderElement">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
  </Style>
  <Style Selector="Border.modalcard CheckBox, Border.modalcard RadioButton">
    <Setter Property="MinHeight" Value="30"/>
    <Setter Property="FontSize" Value="13"/>
  </Style>
  <Style Selector="Border.modalcard Button">
    <Setter Property="MinHeight" Value="32"/>
    <Setter Property="Padding" Value="12,6"/>
  </Style>
  <Style Selector="TextBox.palette-query">
    <Setter Property="Height" Value="38"/>
    <Setter Property="Padding" Value="10,6"/>
    <Setter Property="FontSize" Value="15"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="Background" Value="{DynamicResource WorkspaceHeaderBackgroundBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource WorkspaceSeparatorBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="{DynamicResource DurFast}"/>
        <BrushTransition Property="BorderBrush" Duration="{DynamicResource DurFast}"/>
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="TextBox.palette-query:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="BorderBrush" Value="{DynamicResource ChromeBorderBrush}"/>
  </Style>
  <Style Selector="TextBox.palette-query:focus /template/ Border#PART_BorderElement">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
  </Style>
  <Style Selector="NumericUpDown.modal-field">
    <Setter Property="MinHeight" Value="34"/>
    <Setter Property="Padding" Value="8,4"/>
    <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}"/>
    <Setter Property="Background" Value="{DynamicResource WorkspaceHeaderBackgroundBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource WorkspaceSeparatorBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
  </Style>
  <Style Selector="Button.modal-dismiss">
    <Setter Property="MinWidth" Value="0"/>
    <Setter Property="MinHeight" Value="32"/>
    <Setter Property="Padding" Value="10,6"/>
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Foreground" Value="{DynamicResource ChromeForegroundMutedBrush}"/>
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Foreground" Duration="{DynamicResource DurFast}"/>
      </Transitions>
    </Setter>
  </Style>
  <!-- Own the REST background + its transitions, and do it BEFORE the state styles: Avalonia resolves
       competing setters by document order, not specificity. A class that overrides only :pointerover
       leaves FA's stock template painting its own ButtonBackground at rest and animating through the
       light ButtonBackgroundPointerOver on hover — the first-light-then-dark double flash. Every flat
       chrome button below follows this base-then-states shape (as Button.accent already did). -->
  <Style Selector="Button.modal-dismiss /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent"/>
    <!-- Background only — a BorderBrush transition would fade the keyboard-focus ring in from FA's
         gradient border instead of snapping, and the hover never touches the border. -->
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="{DynamicResource DurFast}"/>
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.modal-dismiss:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource WorkspaceHoverBrush}"/>
  </Style>
  <Style Selector="Button.modal-dismiss:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
  </Style>
  <Style Selector="Border.settings-group">
    <Setter Property="Background" Value="{DynamicResource WorkspaceHeaderBackgroundBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource WorkspaceSeparatorBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="{DynamicResource PanelCornerRadius}"/>
    <Setter Property="Padding" Value="12"/>
  </Style>
  <Style Selector="TextBlock.settings-section">
    <Setter Property="FontSize" Value="11.5"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
  </Style>

  <!-- Welcome workspace: one restrained document mark, a useful drop target and compact shortcut
       keycaps. Everything reuses semantic shell surfaces so all fourteen themes inherit the same
       hierarchy without theme-specific colours. -->
  <Style Selector="Border.welcome-mark">
    <Setter Property="Background" Value="{DynamicResource WorkspaceSelectedBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource WorkspaceSeparatorBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="14"/>
  </Style>
  <Style Selector="Border.drop-zone">
    <Setter Property="Padding" Value="14"/>
    <Setter Property="Background" Value="{DynamicResource WorkspaceHeaderBackgroundBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource WorkspaceSeparatorBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="10"/>
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="{DynamicResource DurFast}"/>
        <BrushTransition Property="BorderBrush" Duration="{DynamicResource DurFast}"/>
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Border.drop-zone:pointerover">
    <Setter Property="Background" Value="{DynamicResource WorkspaceHoverBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
  </Style>
  <Style Selector="Border.drop-icon">
    <Setter Property="Background" Value="{DynamicResource WorkspaceSelectedBrush}"/>
    <Setter Property="CornerRadius" Value="8"/>
  </Style>
  <Style Selector="Border.keycap">
    <Setter Property="Padding" Value="6,3"/>
    <Setter Property="Background" Value="{DynamicResource WorkspaceHeaderBackgroundBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource WorkspaceSeparatorBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="5"/>
    <Setter Property="TextElement.FontSize" Value="10.5"/>
    <Setter Property="TextElement.FontWeight" Value="SemiBold"/>
    <Setter Property="TextElement.Foreground" Value="{DynamicResource ChromeForegroundBrush}"/>
  </Style>
  <Style Selector="Border.welcome-card">
    <Setter Property="Padding" Value="8"/>
    <Setter Property="Background" Value="{DynamicResource WorkspaceHeaderBackgroundBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource WorkspaceSeparatorBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="12"/>
  </Style>
  <Style Selector="Button.welcome-secondary">
    <Setter Property="Padding" Value="14,9"/>
    <Setter Property="CornerRadius" Value="7"/>
    <Setter Property="Background" Value="{DynamicResource WorkspaceHeaderBackgroundBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource WorkspaceSeparatorBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Foreground" Value="{DynamicResource ChromeForegroundBrush}"/>
    <Setter Property="RenderTransformOrigin" Value="50%,50%"/>
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="{DynamicResource DurFast}"/>
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.welcome-secondary /template/ ContentPresenter#PART_ContentPresenter">
    <!-- Rest background is ours (transparent over the welcome card), not FA's — see modal-dismiss.
         Background only: a BorderBrush transition faded the keyboard-focus ring in from FA's gradient
         border instead of snapping, and the hover never recolours the border. -->
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="{DynamicResource DurFast}"/>
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.welcome-secondary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource WorkspaceHoverBrush}"/>
  </Style>
  <Style Selector="Button.welcome-secondary:pressed">
    <Setter Property="RenderTransform" Value="scale(0.98)"/>
  </Style>
  <Style Selector="Button.welcome-secondary:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
  </Style>
  <Style Selector="StackPanel.sidebar-empty">
    <Setter Property="Margin" Value="14,20"/>
    <Setter Property="Spacing" Value="7"/>
  </Style>
  <Style Selector="Border.sidebar-empty-icon">
    <Setter Property="Width" Value="36"/>
    <Setter Property="Height" Value="36"/>
    <Setter Property="CornerRadius" Value="9"/>
    <Setter Property="Background" Value="{DynamicResource WorkspaceSelectedBrush}"/>
    <Setter Property="Margin" Value="0,0,0,3"/>
  </Style>
  <!-- CheckBox/RadioButton resolve their label colour from their own Foreground property (the Fluent
       theme default wins over an inherited TextElement.Foreground), so set it explicitly for the ones
       inside a modal card. Scoped to those two controls only — the accent button keeps its own
       Foreground, and muted section labels override with an inline brush. -->
  <Style Selector="Border.modalcard CheckBox">
    <Setter Property="Foreground" Value="{DynamicResource ChromeForegroundBrush}"/>
  </Style>
  <Style Selector="Border.modalcard RadioButton">
    <Setter Property="Foreground" Value="{DynamicResource ChromeForegroundBrush}"/>
  </Style>

  <!-- Flat-button base: the shared transparent/borderless skin behind every chrome icon/text button
       (statusbtn, segment, findbtn, crumb, chrome-menu, link). Each of those classes keeps only its
       own padding/font/foreground; this grouped selector holds what they all share, so the base lives
       once instead of being repeated across feature views. -->
  <Style Selector="Button.statusbtn, Button.segment, Button.findbtn, Button.crumb, Button.chrome-menu, Button.link, Button.workspace-action, Button.header-action">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
  </Style>
  <Style Selector="Button.statusbtn">
    <Setter Property="MinWidth" Value="0"/>
    <Setter Property="Padding" Value="6,1"/>
    <Setter Property="FontSize" Value="11.5"/>
    <Setter Property="Foreground" Value="{DynamicResource StatusBarForegroundBrush}"/>
    <Setter Property="RenderTransformOrigin" Value="50%,50%"/>
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Foreground" Duration="{DynamicResource DurFast}"/>
        <TransformOperationsTransition Property="RenderTransform" Duration="{DynamicResource DurFast}"/>
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.statusbtn:pointerover">
    <Setter Property="RenderTransform" Value="scale(1.03)"/>
  </Style>
  <Style Selector="Button.statusbtn:pressed">
    <Setter Property="RenderTransform" Value="scale(0.97)"/>
  </Style>
  <Style Selector="Button.statusbtn:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="4"/>
  </Style>
  <!-- Own the rest background + its transition here (same pattern as Button.accent below). FA's stock
       template otherwise paints ButtonBackground at rest and animates to its own light
       ButtonBackgroundPointerOver on hover before our darker overlay lands — the documented
       "first light, then dark" double flash. Pinning rest transparent makes our hover brush the only
       colour that ever shows, so the hover is a single clean fade. -->
  <Style Selector="Button.statusbtn /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="{DynamicResource DurFast}"/>
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.statusbtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource WorkspaceHoverBrush}"/>
  </Style>
  <Style Selector="Button.link:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="4"/>
  </Style>

  <!-- Workspace actions: compact, quiet, and fully keyboard-visible. The active rail section is a
       soft accent-tinted tile rather than a bright icon floating on an empty strip. -->
  <Style Selector="Button.workspace-action">
    <Setter Property="Width" Value="36"/>
    <Setter Property="Height" Value="36"/>
    <Setter Property="Padding" Value="10"/>
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="Foreground" Value="{DynamicResource ChromeForegroundMutedBrush}"/>
    <Setter Property="RenderTransformOrigin" Value="50%,50%"/>
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Foreground" Duration="{DynamicResource DurFast}"/>
        <DoubleTransition Property="Opacity" Duration="{DynamicResource DurFast}"/>
        <TransformOperationsTransition Property="RenderTransform" Duration="{DynamicResource DurFast}"/>
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.workspace-action:pointerover">
    <Setter Property="RenderTransform" Value="scale(1.04)"/>
  </Style>
  <Style Selector="Button.workspace-action:pressed">
    <Setter Property="RenderTransform" Value="scale(0.96)"/>
  </Style>
  <!-- Rest background + transitions are ours, ahead of the states (see modal-dismiss). The .active tile
       below still wins over the hover because it comes later in document order — unchanged. -->
  <Style Selector="Button.workspace-action /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent"/>
    <!-- Background only: a BorderBrush transition here would make the keyboard-focus ring FADE IN from
         FA's gradient ControlElevationBorderBrush instead of snapping (AccessibilityTests catches it),
         and nothing hovers the border anyway. -->
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="{DynamicResource DurFast}"/>
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.workspace-action:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource WorkspaceHoverBrush}"/>
  </Style>
  <Style Selector="Button.workspace-action.active">
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <Style Selector="Button.workspace-action.active /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource WorkspaceSelectedBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
    <Setter Property="BorderThickness" Value="2,0,0,0"/>
  </Style>
  <Style Selector="Button.workspace-action:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
  </Style>
  <Style Selector="Button.workspace-action.active:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
    <Setter Property="BorderThickness" Value="2,1,1,1"/>
  </Style>

  <Style Selector="Button.header-action">
    <Setter Property="MinWidth" Value="0"/>
    <Setter Property="MinHeight" Value="0"/>
    <Setter Property="Padding" Value="10,6"/>
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="Foreground" Value="{DynamicResource ChromeForegroundMutedBrush}"/>
    <Setter Property="RenderTransformOrigin" Value="50%,50%"/>
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Foreground" Duration="{DynamicResource DurFast}"/>
        <TransformOperationsTransition Property="RenderTransform" Duration="{DynamicResource DurFast}"/>
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.header-action:pointerover">
    <Setter Property="RenderTransform" Value="scale(1.03)"/>
  </Style>
  <Style Selector="Button.header-action:pressed">
    <Setter Property="RenderTransform" Value="scale(0.97)"/>
  </Style>
  <!-- Rest background + transition are ours, ahead of the states (see modal-dismiss). -->
  <Style Selector="Button.header-action /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="{DynamicResource DurFast}"/>
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.header-action:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource WorkspaceHoverBrush}"/>
  </Style>
  <Style Selector="Button.header-action:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
  </Style>

  <!-- Shared compact segmented control. Existing view-mode buttons use `seg-on`; keeping the active
       state semantic here also makes the style reusable outside the shell's local style scope. -->
  <Style Selector="Border.segmented">
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="BorderBrush" Value="{DynamicResource WorkspaceSeparatorBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Background" Value="{DynamicResource WorkspaceHeaderBackgroundBrush}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="ClipToBounds" Value="True"/>
  </Style>
  <Style Selector="Button.segment">
    <Setter Property="CornerRadius" Value="0"/>
    <Setter Property="MinWidth" Value="0"/>
    <Setter Property="MinHeight" Value="0"/>
    <Setter Property="Padding" Value="10,6"/>
    <Setter Property="FontSize" Value="11.5"/>
    <Setter Property="Foreground" Value="{DynamicResource ChromeForegroundMutedBrush}"/>
    <Setter Property="RenderTransformOrigin" Value="50%,50%"/>
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Foreground" Duration="{DynamicResource DurFast}"/>
        <TransformOperationsTransition Property="RenderTransform" Duration="{DynamicResource DurFast}"/>
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.segment:pointerover">
    <Setter Property="RenderTransform" Value="scale(1.02)"/>
  </Style>
  <Style Selector="Button.segment:pressed">
    <Setter Property="RenderTransform" Value="scale(0.98)"/>
  </Style>
  <!-- Rest background + transition are ours, ahead of the states (see modal-dismiss). The seg-on tab
       below still wins over the hover because it comes later in document order — unchanged. -->
  <Style Selector="Button.segment /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="{DynamicResource DurFast}"/>
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.segment:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource WorkspaceHoverBrush}"/>
  </Style>
  <Style Selector="Button.segment.seg-on">
    <Setter Property="Foreground" Value="{DynamicResource ChromeForegroundBrush}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <Style Selector="Button.segment.seg-on /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource WorkspaceSelectedBrush}"/>
  </Style>
  <Style Selector="Button.segment:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
  </Style>

  <!-- Premium accent button. FluentAvalonia's built-in `accent` class paints from the generic
       system-accent resources; we drive the primary CTA from the app's own accent tokens instead.
       The background lives on the template's ContentPresenter, so state colours are set through
       /template/ to win over FluentAvalonia's pointerover/pressed setters. -->
  <Style Selector="Button.accent /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}" />
    <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="{DynamicResource DurFast}" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.accent">
    <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="{DynamicResource DurFast}" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="Button.accent:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}" />
  </Style>
  <Style Selector="Button.accent:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}" />
  </Style>
  <!-- Tactile press feedback. -->
  <Style Selector="Button.accent:pressed">
    <Setter Property="RenderTransform" Value="scale(0.97)" />
  </Style>
  <Style Selector="Button.sidebar-open">
    <Setter Property="HorizontalContentAlignment" Value="Left"/>
    <Setter Property="FontSize" Value="12.5"/>
  </Style>

  <!-- Recent-file entries (welcome) and outline (TOC) entries share a custom minimal template
       (Border + ContentPresenter). FluentAvalonia's stock Button template flashed its own light
       pointer-over background before our darker overlay settled — the "first light, then dark"
       flicker. Escaping that template makes the hover a single instant overlay on PART_Bg: no FA
       state, no transition, no fade-through, no shimmer. The Button still fires its Command on click. -->
  <Style Selector="Button.recent">
    <Setter Property="Template">
      <ControlTemplate>
        <Border x:Name="PART_Bg" Background="Transparent" Padding="{TemplateBinding Padding}"
                BorderThickness="1" BorderBrush="Transparent"
                CornerRadius="{DynamicResource ControlCornerRadius}">
          <Border.Transitions>
            <Transitions>
              <BrushTransition Property="Background" Duration="{DynamicResource DurFast}"/>
              <BrushTransition Property="BorderBrush" Duration="{DynamicResource DurFast}"/>
            </Transitions>
          </Border.Transitions>
          <ContentPresenter Content="{TemplateBinding Content}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="Button.recent:pointerover /template/ Border#PART_Bg">
    <Setter Property="Background" Value="{DynamicResource ChromeOverlayBrush}" />
  </Style>
  <Style Selector="Button.recent:pressed /template/ Border#PART_Bg">
    <Setter Property="Background" Value="{DynamicResource ChromeOverlayBrush}" />
  </Style>
  <!-- Keyboard focus ring: the custom template drops FluentAvalonia's focus adorner, so paint the
       (always-present, transparent) 1px border with the accent when focused via the keyboard. -->
  <Style Selector="Button.recent:focus-visible /template/ Border#PART_Bg">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
  </Style>

  <Style Selector="Button.outline-item">
    <Setter Property="Template">
      <ControlTemplate>
        <Border x:Name="PART_Bg" Background="Transparent" Padding="{TemplateBinding Padding}" BorderThickness="1" BorderBrush="Transparent" CornerRadius="4">
          <Border.Transitions>
            <Transitions>
              <BrushTransition Property="Background" Duration="{DynamicResource DurFast}"/>
              <BrushTransition Property="BorderBrush" Duration="{DynamicResource DurFast}"/>
            </Transitions>
          </Border.Transitions>
          <ContentPresenter Content="{TemplateBinding Content}"
                            Foreground="{TemplateBinding Foreground}"
                            FontSize="{TemplateBinding FontSize}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="Button.outline-item:pointerover /template/ Border#PART_Bg">
    <Setter Property="Background" Value="{DynamicResource OutlineItemHoverBrush}" />
  </Style>
  <Style Selector="Button.outline-item:pressed /template/ Border#PART_Bg">
    <Setter Property="Background" Value="{DynamicResource OutlineItemHoverBrush}" />
  </Style>
  <Style Selector="Button.outline-item:focus-visible /template/ Border#PART_Bg">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
  </Style>

  <!-- ☰ title-bar menu flyout: use the app's dark status-bar backing (and its submenus) instead of
       FluentAvalonia's light acrylic, so the dropdown matches the rest of the chrome. -->
  <Style Selector="MenuFlyoutPresenter">
    <Setter Property="Background" Value="{DynamicResource StatusBarBackgroundBrush}" />
  </Style>

  <!-- Hamburger (☰) menu trigger in the title bar: flat and chrome-coloured, with FluentAvalonia's
       built-in pointerover/pressed states (transparent base lets the title strip show through). -->
  <Style Selector="Button.chrome-menu">
    <Setter Property="Foreground" Value="{DynamicResource ChromeForegroundBrush}" />
    <Setter Property="Padding" Value="9,4" />
  </Style>

  <!-- Outline-sidebar resize handle: a wide-enough hit area that stays invisible until hovered,
       then shows a faint chrome-coloured hairline (the outline panel already draws the 1px divider). -->
  <Style Selector="GridSplitter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="GridSplitter:pointerover">
    <Setter Property="Background" Value="{DynamicResource ChromeBorderBrush}" />
  </Style>

</Styles>
