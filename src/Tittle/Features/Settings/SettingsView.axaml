<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shared="using:Tittle.Shared"
             xmlns:settings="using:Tittle.Features.Settings"
             xmlns:core="using:Tittle.Core.Settings"
             xmlns:abs="using:Tittle.Core.Abstractions"
             xmlns:vm="using:Tittle.Features.Shell"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="640"
             x:Class="Tittle.Features.Settings.SettingsView"
             x:DataType="vm:MainWindowViewModel"
             Background="{DynamicResource EditorSurfaceBrush}">
  <!-- The settings-page styles (SettingRow, category rail, pickers) live here rather than in the global
       Application.Styles: this is their only consumer, so they parse lazily with the page, not at startup. -->
  <UserControl.Styles>
    <StyleInclude Source="avares://Tittle/Themes/Settings.axaml" />
    <!-- Accent swatch: a coloured circle. A minimal template makes the local Background win over the
         FluentAvalonia button background, so each swatch shows its actual accent colour. -->
    <Style Selector="Button.accent-swatch">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Margin" Value="0,0,8,4"/>
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}" Width="26" Height="26" CornerRadius="13"
                  BorderThickness="1" BorderBrush="{DynamicResource ChromeBorderBrush}">
            <ContentPresenter Content="{TemplateBinding Content}"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="Button.accent-swatch:pointerover /template/ Border">
      <Setter Property="BorderBrush" Value="{DynamicResource ChromeForegroundMutedBrush}"/>
    </Style>
  </UserControl.Styles>
  <!-- Settings shown INLINE as a full page (a "tab"), not a floating window: it fills the content area, so
       nothing clips. DataContext is the shell VM — the Раскладка/Чтение pages scope to Layout, Диаграммы to
       Diagrams, and Готово closes the page. Mutually exclusive with the document view (never overlays a live
       editor). Reuses the same settings styles as before (Themes/Settings.axaml). -->
  <Grid HorizontalAlignment="Center" VerticalAlignment="Stretch"
        MaxWidth="940" Margin="24,20,24,20">
    <DockPanel>

      <StackPanel DockPanel.Dock="Top" Spacing="3" Margin="0,0,0,18">
        <TextBlock Text="Настройки" FontSize="20" FontWeight="SemiBold"/>
        <TextBlock Text="Соберите рабочее пространство под свой ритм чтения и редактирования."
                   TextWrapping="Wrap" FontSize="12.5"
                   Foreground="{DynamicResource ChromeForegroundMutedBrush}"/>
      </StackPanel>

      <Button DockPanel.Dock="Bottom" Content="Готово" HorizontalAlignment="Right" Classes="accent"
              Margin="0,18,0,0" Command="{Binding CloseSettingsCommand}"
              AutomationProperties.Name="Закрыть настройки"/>

      <!-- Categories left, one page right. Only the page scrolls, and only if it has to. -->
      <TabControl Classes="settings-nav" TabStripPlacement="Left"
                  AutomationProperties.AutomationId="SettingsCategories">

        <TabItem Classes="settings-tab" Header="Раскладка">
          <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                        Padding="0,0,10,0">
            <StackPanel DataContext="{Binding Layout}" x:DataType="shared:LayoutOptions">
              <TextBlock Text="ОКНО" Classes="settings-heading"/>
              <Border Classes="settings-rule"/>

              <settings:SettingRow Label="Омнибар"
                                   Description="Строка с путём к файлу, кнопкой «Открыть» и палитрой команд.">
                <CheckBox IsChecked="{Binding ShowOmnibar, Mode=TwoWay}"
                          AutomationProperties.Name="Омнибар"/>
              </settings:SettingRow>

              <settings:SettingRow Label="Панель инструментов"
                                   Description="Ряд кнопок под вкладками: поиск, перенос строк, номера строк.">
                <ComboBox Classes="settings-pick"
                          ItemsSource="{x:Static settings:SettingChoices.ToolbarModes}"
                          DisplayMemberBinding="{Binding Label}"
                          SelectedValueBinding="{Binding Value}"
                          SelectedValue="{Binding ToolbarMode, Mode=TwoWay}"
                          AutomationProperties.Name="Панель инструментов"/>
              </settings:SettingRow>

              <settings:SettingRow Label="Разделённый вид"
                                   Description="Как располагать исходник и предпросмотр рядом друг с другом.">
                <ComboBox Classes="settings-pick"
                          ItemsSource="{x:Static settings:SettingChoices.SplitOrientations}"
                          DisplayMemberBinding="{Binding Label}"
                          SelectedValueBinding="{Binding Value}"
                          SelectedValue="{Binding SplitOrientation, Mode=TwoWay}"
                          AutomationProperties.Name="Ориентация разделённого вида"/>
              </settings:SettingRow>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <TabItem Classes="settings-tab" Header="Чтение">
          <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                        Padding="0,0,10,0">
            <StackPanel>
              <!-- ПРЕВЬЮ (ported): a live sample in the current preview font + body size, so a font/size
                   change is visible without switching to the document. FontFamily reads the same
                   PreviewFontFamily resource the preview uses; the body size tracks Editor.FontSize. -->
              <Border Padding="16,12" CornerRadius="8" Margin="0,0,0,14" BorderThickness="1"
                      Background="{DynamicResource EditorSurfaceBrush}"
                      BorderBrush="{DynamicResource ChromeBorderBrush}">
                <StackPanel Spacing="6">
                  <TextBlock Text="Образец заголовка" FontWeight="SemiBold" FontSize="19"
                             FontFamily="{DynamicResource PreviewFontFamily}"/>
                  <TextBlock TextWrapping="Wrap"
                             FontFamily="{DynamicResource PreviewFontFamily}"
                             FontSize="{Binding Editor.FontSize}"
                             Text="Текст в актуальных настройках. Числа 1234567890, а также курсив и полужирное."/>
                </StackPanel>
              </Border>

              <!-- ШАБЛОНЫ (ported): one-click bundles. Bound to the shell VM's command (not Layout),
                   so this outer panel keeps the VM DataContext; the reading knobs below scope to Layout. -->
              <TextBlock Text="ШАБЛОНЫ" Classes="settings-heading"/>
              <Border Classes="settings-rule"/>
              <UniformGrid Columns="2" Margin="0,4,0,12">
                <Button Content="📖 Чтение" Classes="flat" Margin="0,0,6,6" HorizontalAlignment="Stretch"
                        Command="{Binding ApplyReadingTemplateCommand}"
                        CommandParameter="{x:Static core:ReadingTemplate.Reading}"/>
                <Button Content="🛠 Разработка" Classes="flat" Margin="0,0,0,6" HorizontalAlignment="Stretch"
                        Command="{Binding ApplyReadingTemplateCommand}"
                        CommandParameter="{x:Static core:ReadingTemplate.Developer}"/>
                <Button Content="▬ Компактно" Classes="flat" Margin="0,0,6,0" HorizontalAlignment="Stretch"
                        Command="{Binding ApplyReadingTemplateCommand}"
                        CommandParameter="{x:Static core:ReadingTemplate.Compact}"/>
                <Button Content="🖨 Печать" Classes="flat" HorizontalAlignment="Stretch"
                        Command="{Binding ApplyReadingTemplateCommand}"
                        CommandParameter="{x:Static core:ReadingTemplate.Printable}"/>
              </UniformGrid>

              <!-- АКЦЕНТ (ported accentColor): swatches bound to the shell VM's SetAccent command. -->
              <TextBlock Text="АКЦЕНТ" Classes="settings-heading"/>
              <Border Classes="settings-rule"/>
              <WrapPanel Margin="0,6,0,12">
                <Button Classes="accent-swatch" Background="Transparent" Content="↺" ToolTip.Tip="По теме"
                        Command="{Binding SetAccentCommand}" CommandParameter=""/>
                <Button Classes="accent-swatch" Background="{x:Static shared:AccentPalette.Blue}" ToolTip.Tip="Синий"
                        Command="{Binding SetAccentCommand}" CommandParameter="#3B82F6"/>
                <Button Classes="accent-swatch" Background="{x:Static shared:AccentPalette.Purple}" ToolTip.Tip="Фиолетовый"
                        Command="{Binding SetAccentCommand}" CommandParameter="#8B5CF6"/>
                <Button Classes="accent-swatch" Background="{x:Static shared:AccentPalette.Green}" ToolTip.Tip="Зелёный"
                        Command="{Binding SetAccentCommand}" CommandParameter="#22C55E"/>
                <Button Classes="accent-swatch" Background="{x:Static shared:AccentPalette.Red}" ToolTip.Tip="Красный"
                        Command="{Binding SetAccentCommand}" CommandParameter="#EF4444"/>
                <Button Classes="accent-swatch" Background="{x:Static shared:AccentPalette.Orange}" ToolTip.Tip="Оранжевый"
                        Command="{Binding SetAccentCommand}" CommandParameter="#F97316"/>
                <Button Classes="accent-swatch" Background="{x:Static shared:AccentPalette.Pink}" ToolTip.Tip="Розовый"
                        Command="{Binding SetAccentCommand}" CommandParameter="#EC4899"/>
              </WrapPanel>

              <!-- ТЕМА (ported): the full 15-theme catalog, reachable from settings (was palette/menu only).
                   Two-way to the VM's CurrentTheme, so external changes (Ctrl+Shift+T) reflect here too. -->
              <TextBlock Text="ТЕМА" Classes="settings-heading"/>
              <Border Classes="settings-rule"/>
              <settings:SettingRow Label="Тема оформления"
                                   Description="Цветовая тема окна. «Авто (как в системе)» следует за системной.">
                <ComboBox Classes="settings-pick"
                          ItemsSource="{x:Static abs:ThemeCatalog.All}"
                          DisplayMemberBinding="{Binding DisplayName}"
                          SelectedValueBinding="{Binding Mode}"
                          SelectedValue="{Binding CurrentTheme, Mode=TwoWay}"
                          AutomationProperties.Name="Тема оформления"/>
              </settings:SettingRow>

              <TextBlock Text="РАЗМЕР" Classes="settings-heading"/>
              <Border Classes="settings-rule"/>
              <settings:SettingRow Label="Размер текста"
                                   Description="Масштаб предпросмотра и редактора (Ctrl+± и Ctrl+колесо тоже меняют).">
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                  <Slider Width="196" Minimum="8" Maximum="32" TickFrequency="1" IsSnapToTickEnabled="True"
                          VerticalAlignment="Center" Value="{Binding Editor.FontSize, Mode=TwoWay}"
                          AutomationProperties.Name="Размер текста"/>
                  <TextBlock Width="40" TextAlignment="Right" VerticalAlignment="Center"
                             Text="{Binding Editor.FontSize, StringFormat={}{0:0} px}"/>
                </StackPanel>
              </settings:SettingRow>

            <StackPanel DataContext="{Binding Layout}" x:DataType="shared:LayoutOptions">
              <TextBlock Text="ТЕКСТ" Classes="settings-heading"/>
              <Border Classes="settings-rule"/>

              <settings:SettingRow Label="Шрифт"
                                   Description="Гарнитура текста предпросмотра: без засечек, с засечками или моноширинный.">
                <ComboBox Classes="settings-pick"
                          ItemsSource="{x:Static settings:SettingChoices.ReadingFonts}"
                          DisplayMemberBinding="{Binding Label}"
                          SelectedValueBinding="{Binding Value}"
                          SelectedValue="{Binding FontFamily, Mode=TwoWay}"
                          AutomationProperties.Name="Шрифт предпросмотра"/>
              </settings:SettingRow>

              <settings:SettingRow Label="Ширина колонки"
                                   Description="Сколько текста умещается в строке. Узкая колонка читается легче.">
                <ComboBox Classes="settings-pick"
                          ItemsSource="{x:Static settings:SettingChoices.ReadingWidths}"
                          DisplayMemberBinding="{Binding Label}"
                          SelectedValueBinding="{Binding Value}"
                          SelectedValue="{Binding ReadingWidth, Mode=TwoWay}"
                          AutomationProperties.Name="Ширина колонки чтения"/>
              </settings:SettingRow>

              <settings:SettingRow Label="Разрежённость текста"
                                   Description="Готовый пресет: задаёт интервал между строками и отступ между абзацами.">
                <ComboBox Classes="settings-pick"
                          ItemsSource="{x:Static settings:SettingChoices.ReadingDensities}"
                          DisplayMemberBinding="{Binding Label}"
                          SelectedValueBinding="{Binding Value}"
                          SelectedValue="{Binding ReadingDensity, Mode=TwoWay}"
                          AutomationProperties.Name="Разрежённость текста"/>
              </settings:SettingRow>

              <settings:SettingRow Label="Выравнивание"
                                   Description="Как выключен текст в предпросмотре: по левому краю или по центру.">
                <ComboBox Classes="settings-pick"
                          ItemsSource="{x:Static settings:SettingChoices.TextAlignments}"
                          DisplayMemberBinding="{Binding Label}"
                          SelectedValueBinding="{Binding Value}"
                          SelectedValue="{Binding TextAlignment, Mode=TwoWay}"
                          AutomationProperties.Name="Выравнивание текста"/>
              </settings:SettingRow>

              <settings:SettingRow Label="Нумеровать заголовки"
                                   Description="Показывать иерархические номера (1, 1.1, 1.1.1) перед заголовками в предпросмотре.">
                <CheckBox IsChecked="{Binding NumberHeadings, Mode=TwoWay}"
                          AutomationProperties.Name="Нумеровать заголовки"/>
              </settings:SettingRow>

              <TextBlock Text="ТОНКАЯ НАСТРОЙКА" Classes="settings-heading" Margin="0,8,0,2"/>
              <Border Classes="settings-rule"/>

              <settings:SettingRow Label="Интервал между строками"
                                   Description="Доп. пиксели между перенесёнными строками внутри абзаца.">
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                  <Slider Width="196" Minimum="0" Maximum="40" TickFrequency="1" IsSnapToTickEnabled="True"
                          VerticalAlignment="Center" Value="{Binding LineSpacing, Mode=TwoWay}"
                          AutomationProperties.Name="Интервал между строками"/>
                  <TextBlock Width="30" TextAlignment="Right" VerticalAlignment="Center"
                             Text="{Binding LineSpacing, StringFormat={}{0:0}}"/>
                </StackPanel>
              </settings:SettingRow>

              <settings:SettingRow Label="Отступ между абзацами"
                                   Description="Вертикальный зазор до и после каждого абзаца, списка, таблицы.">
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                  <Slider Width="196" Minimum="0" Maximum="48" TickFrequency="1" IsSnapToTickEnabled="True"
                          VerticalAlignment="Center" Value="{Binding ParagraphSpacing, Mode=TwoWay}"
                          AutomationProperties.Name="Отступ между абзацами"/>
                  <TextBlock Width="30" TextAlignment="Right" VerticalAlignment="Center"
                             Text="{Binding ParagraphSpacing, StringFormat={}{0:0}}"/>
                </StackPanel>
              </settings:SettingRow>

              <settings:SettingRow Label="Размер заголовков"
                                   Description="Насколько названия секций крупнее обычного текста.">
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                  <Slider Width="196" Minimum="0.7" Maximum="1.8" TickFrequency="0.05" IsSnapToTickEnabled="True"
                          VerticalAlignment="Center" Value="{Binding HeadingScale, Mode=TwoWay}"
                          AutomationProperties.Name="Размер заголовков"/>
                  <TextBlock Width="34" TextAlignment="Right" VerticalAlignment="Center"
                             Text="{Binding HeadingScale, StringFormat={}{0:0.00}×}"/>
                </StackPanel>
              </settings:SettingRow>

              <TextBlock Text="РЕЖИМЫ" Classes="settings-heading" Margin="0,8,0,2"/>
              <Border Classes="settings-rule"/>
              <settings:SettingRow Label="Хлебные крошки"
                                   Description="Полоса пути по заголовкам над документом.">
                <CheckBox IsChecked="{Binding ShowBreadcrumbs, Mode=TwoWay}"
                          AutomationProperties.Name="Хлебные крошки"/>
              </settings:SettingRow>
              <settings:SettingRow Label="Миникарта"
                                   Description="Мини-обзор структуры рядом с редактором (для кода и текста).">
                <CheckBox IsChecked="{Binding ShowMinimap, Mode=TwoWay}"
                          AutomationProperties.Name="Миникарта"/>
              </settings:SettingRow>
            </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <!-- Diagrams (M12): scoped to the shared DiagramOptions. -->
        <TabItem Classes="settings-tab" Header="Диаграммы">
          <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                        Padding="0,0,10,0">
            <StackPanel DataContext="{Binding Diagrams}" x:DataType="shared:DiagramOptions">
              <TextBlock Text="KROKI" Classes="settings-heading"/>
              <Border Classes="settings-rule"/>

              <settings:SettingRow Label="Рендерить диаграммы"
                                   Description="Блоки ```mermaid, ```plantuml, ```dot … превращаются в картинки.">
                <CheckBox IsChecked="{Binding Enabled, Mode=TwoWay}"
                          AutomationProperties.Name="Рендерить диаграммы через Kroki"/>
              </settings:SettingRow>

              <settings:SettingRow Label="Адрес сервера"
                                   Description="Можно указать свой self-hosted Kroki.">
                <TextBox Classes="modal-field" Width="268"
                         Text="{Binding KrokiUrl, Mode=TwoWay}" IsEnabled="{Binding Enabled}"
                         Watermark="https://kroki.io"
                         AutomationProperties.Name="Адрес сервера Kroki"/>
              </settings:SettingRow>

              <TextBlock TextWrapping="Wrap" FontSize="11.5" Margin="0,2,0,0"
                         Foreground="{DynamicResource ChromeForegroundMutedBrush}"
                         Text="Текст диаграммы отправляется на указанный сервер. По умолчанию выключено."/>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <!-- Privacy (viewer-port): private mode + clear-data. Binds to the shell VM directly (no
             DataContext override) — IsPrivateMode / ClearViewerDataCommand live on the VM. -->
        <TabItem Classes="settings-tab" Header="Приватность">
          <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                        Padding="0,0,10,0">
            <StackPanel>
              <TextBlock Text="ИСТОРИЯ" Classes="settings-heading"/>
              <Border Classes="settings-rule"/>

              <settings:SettingRow Label="Приватный режим"
                                   Description="Не сохранять сессию, недавние файлы и отметки о прочитанном. Настройки и закладки остаются.">
                <CheckBox IsChecked="{Binding IsPrivateMode, Mode=TwoWay}"
                          AutomationProperties.Name="Приватный режим"/>
              </settings:SettingRow>

              <settings:SettingRow Label="Очистить данные вьюера"
                                   Description="Удалить недавние файлы, закладки, отметки о прочитанном и сохранённую сессию. Настройки не затрагиваются.">
                <Button Content="Очистить" Classes="flat"
                        Command="{Binding ClearViewerDataCommand}"
                        AutomationProperties.Name="Очистить данные вьюера"/>
              </settings:SettingRow>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

      </TabControl>
    </DockPanel>
  </Grid>
</UserControl>
