<shared:ModalWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shared="using:Tittle.Shared"
        xmlns:settings="using:Tittle.Features.Settings"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="720" d:DesignHeight="520"
        x:Class="Tittle.Features.Settings.LayoutSettingsWindow"
        x:DataType="shared:LayoutOptions"
        Title="Настройки"
        Width="720" Height="520" CanResize="False">
  <!-- Bound to the shared LayoutOptions, so every change persists and re-renders the chrome live. Stays
       open (no click-away close) so the user can watch the changes; Esc / Готово close it.
       Chrome = ModalWindow + Border.modalcard. Layout rationale lives in Themes/Settings.axaml. -->
  <Border Classes="modalcard" Padding="24">
    <DockPanel>

      <StackPanel DockPanel.Dock="Top" Spacing="3" Margin="0,0,0,18">
        <TextBlock Text="Настройки" FontSize="18" FontWeight="SemiBold"/>
        <TextBlock Text="Соберите рабочее пространство под свой ритм чтения и редактирования."
                   TextWrapping="Wrap" FontSize="12"
                   Foreground="{DynamicResource ChromeForegroundMutedBrush}"/>
      </StackPanel>

      <Button DockPanel.Dock="Bottom" Content="Готово" HorizontalAlignment="Right" Classes="accent"
              Margin="0,18,0,0"
              AutomationProperties.Name="Закрыть настройки" Click="OnCloseClick"/>

      <!-- Categories left, one page right. Only the page scrolls, and only if it has to — so the
           scrollbar can never cut across the content the way it did in the old single column. -->
      <TabControl Classes="settings-nav" TabStripPlacement="Left"
                  AutomationProperties.AutomationId="SettingsCategories">

        <TabItem Classes="settings-tab" Header="Раскладка">
          <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                        Padding="0,0,10,0">
            <StackPanel>
              <TextBlock Text="ОКНО" Classes="settings-heading"/>
              <Border Classes="settings-rule"/>

              <settings:SettingRow Label="Омнибар"
                                   Description="Строка с путём к файлу, кнопкой «Открыть» и палитрой команд.">
                <CheckBox IsChecked="{Binding ShowOmnibar, Mode=TwoWay}"
                          AutomationProperties.Name="Омнибар"/>
              </settings:SettingRow>

              <settings:SettingRow Label="Панель инструментов"
                                   Description="Ряд кнопок под вкладками: поиск, перенос строк, номера строк.">
                <ComboBox Classes="settings-pick"
                          ItemsSource="{x:Static settings:SettingChoices.ToolbarModes}"
                          DisplayMemberBinding="{Binding Label}"
                          SelectedValueBinding="{Binding Value}"
                          SelectedValue="{Binding ToolbarMode, Mode=TwoWay}"
                          AutomationProperties.Name="Панель инструментов"/>
              </settings:SettingRow>

              <settings:SettingRow Label="Разделённый вид"
                                   Description="Как располагать исходник и предпросмотр рядом друг с другом.">
                <ComboBox Classes="settings-pick"
                          ItemsSource="{x:Static settings:SettingChoices.SplitOrientations}"
                          DisplayMemberBinding="{Binding Label}"
                          SelectedValueBinding="{Binding Value}"
                          SelectedValue="{Binding SplitOrientation, Mode=TwoWay}"
                          AutomationProperties.Name="Ориентация разделённого вида"/>
              </settings:SettingRow>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <TabItem Classes="settings-tab" Header="Чтение">
          <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                        Padding="0,0,10,0">
            <StackPanel>
              <TextBlock Text="ТЕКСТ" Classes="settings-heading"/>
              <Border Classes="settings-rule"/>

              <settings:SettingRow Label="Ширина колонки"
                                   Description="Сколько текста умещается в строке. Узкая колонка читается легче.">
                <ComboBox Classes="settings-pick"
                          ItemsSource="{x:Static settings:SettingChoices.ReadingWidths}"
                          DisplayMemberBinding="{Binding Label}"
                          SelectedValueBinding="{Binding Value}"
                          SelectedValue="{Binding ReadingWidth, Mode=TwoWay}"
                          AutomationProperties.Name="Ширина колонки чтения"/>
              </settings:SettingRow>

              <settings:SettingRow Label="Разрежённость текста"
                                   Description="Готовый пресет: задаёт интервал между строками и отступ между абзацами.">
                <ComboBox Classes="settings-pick"
                          ItemsSource="{x:Static settings:SettingChoices.ReadingDensities}"
                          DisplayMemberBinding="{Binding Label}"
                          SelectedValueBinding="{Binding Value}"
                          SelectedValue="{Binding ReadingDensity, Mode=TwoWay}"
                          AutomationProperties.Name="Разрежённость текста"/>
              </settings:SettingRow>

              <settings:SettingRow Label="Выравнивание"
                                   Description="Как выключен текст в предпросмотре: по левому краю или по центру.">
                <ComboBox Classes="settings-pick"
                          ItemsSource="{x:Static settings:SettingChoices.TextAlignments}"
                          DisplayMemberBinding="{Binding Label}"
                          SelectedValueBinding="{Binding Value}"
                          SelectedValue="{Binding TextAlignment, Mode=TwoWay}"
                          AutomationProperties.Name="Выравнивание текста"/>
              </settings:SettingRow>

              <TextBlock Text="ТОНКАЯ НАСТРОЙКА" Classes="settings-heading" Margin="0,8,0,2"/>
              <Border Classes="settings-rule"/>

              <settings:SettingRow Label="Интервал между строками"
                                   Description="Доп. пиксели между перенесёнными строками внутри абзаца.">
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                  <Slider Width="196" Minimum="0" Maximum="40" TickFrequency="1" IsSnapToTickEnabled="True"
                          VerticalAlignment="Center" Value="{Binding LineSpacing, Mode=TwoWay}"
                          AutomationProperties.Name="Интервал между строками"/>
                  <TextBlock Width="30" TextAlignment="Right" VerticalAlignment="Center"
                             Text="{Binding LineSpacing, StringFormat={}{0:0}}"/>
                </StackPanel>
              </settings:SettingRow>

              <settings:SettingRow Label="Отступ между абзацами"
                                   Description="Вертикальный зазор до и после каждого абзаца, списка, таблицы.">
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                  <Slider Width="196" Minimum="0" Maximum="48" TickFrequency="1" IsSnapToTickEnabled="True"
                          VerticalAlignment="Center" Value="{Binding ParagraphSpacing, Mode=TwoWay}"
                          AutomationProperties.Name="Отступ между абзацами"/>
                  <TextBlock Width="30" TextAlignment="Right" VerticalAlignment="Center"
                             Text="{Binding ParagraphSpacing, StringFormat={}{0:0}}"/>
                </StackPanel>
              </settings:SettingRow>

              <settings:SettingRow Label="Размер заголовков"
                                   Description="Насколько названия секций крупнее обычного текста.">
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                  <Slider Width="196" Minimum="0.7" Maximum="1.8" TickFrequency="0.05" IsSnapToTickEnabled="True"
                          VerticalAlignment="Center" Value="{Binding HeadingScale, Mode=TwoWay}"
                          AutomationProperties.Name="Размер заголовков"/>
                  <TextBlock Width="34" TextAlignment="Right" VerticalAlignment="Center"
                             Text="{Binding HeadingScale, StringFormat={}{0:0.00}×}"/>
                </StackPanel>
              </settings:SettingRow>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <!-- Diagrams (M12). DataContext is the shared DiagramOptions, assigned in code-behind. -->
        <TabItem Classes="settings-tab" Header="Диаграммы">
          <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                        Padding="0,0,10,0">
            <StackPanel x:Name="DiagramSection" x:DataType="shared:DiagramOptions">
              <TextBlock Text="KROKI" Classes="settings-heading"/>
              <Border Classes="settings-rule"/>

              <settings:SettingRow Label="Рендерить диаграммы"
                                   Description="Блоки ```mermaid, ```plantuml, ```dot … превращаются в картинки.">
                <CheckBox IsChecked="{Binding Enabled, Mode=TwoWay}"
                          AutomationProperties.Name="Рендерить диаграммы через Kroki"/>
              </settings:SettingRow>

              <settings:SettingRow Label="Адрес сервера"
                                   Description="Можно указать свой self-hosted Kroki.">
                <!-- Same width as the dropdowns: the controls form one column down the page. -->
                <TextBox Classes="modal-field" Width="268"
                         Text="{Binding KrokiUrl, Mode=TwoWay}" IsEnabled="{Binding Enabled}"
                         Watermark="https://kroki.io"
                         AutomationProperties.Name="Адрес сервера Kroki"/>
              </settings:SettingRow>

              <!-- The privacy consequence is the whole point of this being opt-in: say it plainly, and
                   keep it in the section rather than hiding it in a row description. -->
              <TextBlock TextWrapping="Wrap" FontSize="11.5" Margin="0,2,0,0"
                         Foreground="{DynamicResource ChromeForegroundMutedBrush}"
                         Text="Текст диаграммы отправляется на указанный сервер. По умолчанию выключено."/>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

      </TabControl>
    </DockPanel>
  </Border>
</shared:ModalWindow>
