<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Tittle.Features.Shell"
             xmlns:conv="using:Tittle.Shared"
             x:Class="Tittle.Features.Shell.Workspace.BookmarkPanel"
             x:DataType="vm:MainWindowViewModel">
  <Grid>
    <StackPanel Classes="sidebar-empty"
                IsVisible="{Binding !SelectedTab.HasBookmarkedOutline, FallbackValue=True}">
      <Border Classes="sidebar-empty-icon">
        <PathIcon Data="{StaticResource IconBookmarkOutline}" Width="16" Height="16"
                  HorizontalAlignment="Center" VerticalAlignment="Center"
                  Foreground="{DynamicResource AccentBrush}"/>
      </Border>
      <TextBlock Text="Нет закладок" FontWeight="SemiBold"/>
      <TextBlock Text="Сохраните важный заголовок в оглавлении — он появится здесь."
                 TextWrapping="Wrap" FontSize="11.5"
                 Foreground="{DynamicResource ChromeForegroundMutedBrush}"/>
    </StackPanel>

    <ItemsControl ItemsSource="{Binding SelectedTab.BookmarkedOutline}"
                  IsVisible="{Binding SelectedTab.HasBookmarkedOutline, FallbackValue=False}">
      <ItemsControl.Template>
        <ControlTemplate>
          <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto" Padding="6,4">
            <ItemsPresenter/>
          </ScrollViewer>
        </ControlTemplate>
      </ItemsControl.Template>
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <VirtualizingStackPanel/>
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:CompileBindings="False">
          <Grid ColumnDefinitions="18,*,Auto"
                Margin="{Binding Level, Converter={x:Static conv:LevelToIndentConverter.Instance}}">
            <PathIcon Data="{StaticResource IconBookmark}" Width="12" Height="12"
                      VerticalAlignment="Center" HorizontalAlignment="Center"
                      Foreground="{DynamicResource AccentBrush}"/>
            <Button Grid.Column="1" Content="{Binding Text}"
                    AutomationProperties.Name="{Binding Text}"
                    Command="{Binding $parent[ItemsControl].DataContext.SelectedTab.NavigateToHeadingCommand}"
                    CommandParameter="{Binding}"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                    Background="Transparent" BorderThickness="0" Padding="8,5"
                    FontSize="12.5"/>
            <Button Grid.Column="2" Classes="header-action"
                    Command="{Binding $parent[ItemsControl].DataContext.SelectedTab.ToggleBookmarkCommand}"
                    CommandParameter="{Binding}"
                    ToolTip.Tip="Убрать закладку"
                    AutomationProperties.Name="Убрать закладку">
              <PathIcon Data="{StaticResource IconClose}" Width="10" Height="10"/>
            </Button>
          </Grid>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </Grid>
</UserControl>
