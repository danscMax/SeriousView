<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Tittle.Features.Shell"
             xmlns:settings="using:Tittle.Core.Settings"
             x:Class="Tittle.Features.Shell.Workspace.WorkspaceRail"
             x:DataType="vm:MainWindowViewModel"
             Width="{DynamicResource WorkspaceRailWidth}">
  <Border Background="{DynamicResource WorkspaceRailBrush}"
          BorderBrush="{DynamicResource WorkspaceSeparatorBrush}"
          BorderThickness="0,0,1,0">
    <Grid RowDefinitions="Auto,*,Auto" Margin="4,6"
          KeyboardNavigation.TabNavigation="Continue">
      <StackPanel Grid.Row="0" Spacing="4">
        <Button Classes="workspace-action"
                TabIndex="0"
                Classes.active="{Binding IsFilesSectionActive}"
                Command="{Binding OpenWorkspaceSectionCommand}"
                CommandParameter="{x:Static settings:WorkspaceSection.Files}"
                ToolTip.Tip="Файлы"
                AutomationProperties.Name="Открыть файлы">
          <PathIcon Data="{StaticResource IconDocument}" Width="17" Height="17"/>
        </Button>
        <Button Classes="workspace-action"
                TabIndex="1"
                Command="{Binding OpenSearchCommand}"
                ToolTip.Tip="Поиск (Ctrl+F)"
                AutomationProperties.Name="Поиск">
          <PathIcon Data="{StaticResource IconSearch}" Width="17" Height="17"/>
        </Button>
        <Button Classes="workspace-action"
                TabIndex="2"
                Classes.active="{Binding IsOutlineSectionActive}"
                Command="{Binding OpenWorkspaceSectionCommand}"
                CommandParameter="{x:Static settings:WorkspaceSection.Outline}"
                ToolTip.Tip="Оглавление"
                AutomationProperties.Name="Оглавление">
          <PathIcon Data="{StaticResource IconSidebar}" Width="17" Height="17"/>
        </Button>
        <Button Classes="workspace-action"
                TabIndex="3"
                Classes.active="{Binding IsBookmarksSectionActive}"
                Command="{Binding OpenWorkspaceSectionCommand}"
                CommandParameter="{x:Static settings:WorkspaceSection.Bookmarks}"
                ToolTip.Tip="Закладки"
                AutomationProperties.Name="Закладки">
          <PathIcon Data="{StaticResource IconBookmark}" Width="17" Height="17"/>
        </Button>
        <Button Classes="workspace-action"
                TabIndex="4"
                Click="OnCommandPaletteClick"
                ToolTip.Tip="Командная палитра (Ctrl+K)"
                AutomationProperties.Name="Командная палитра">
          <PathIcon Data="{StaticResource IconCommand}" Width="17" Height="17"/>
        </Button>
      </StackPanel>

      <StackPanel Grid.Row="2" Spacing="4">
        <Button Classes="workspace-action"
                TabIndex="5"
                Command="{Binding OpenLayoutSettingsCommand}"
                ToolTip.Tip="Настройки"
                AutomationProperties.Name="Настройки">
          <PathIcon Data="{StaticResource IconSettings}" Width="17" Height="17"/>
        </Button>
        <Button Classes="workspace-action"
                TabIndex="6"
                Command="{Binding ShowHelpCommand}"
                ToolTip.Tip="Справка (F1)"
                AutomationProperties.Name="Справка">
          <PathIcon Data="{StaticResource IconHelp}" Width="17" Height="17"/>
        </Button>
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
