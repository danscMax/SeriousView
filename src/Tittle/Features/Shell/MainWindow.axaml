<wnd:AppWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Tittle.Features.Shell"
        xmlns:workspace="using:Tittle.Features.Shell.Workspace"
        xmlns:controls="using:Tittle.Features.Viewer"
        xmlns:views="using:Tittle.Features.Welcome"
        xmlns:settings="using:Tittle.Features.Settings"
        xmlns:conv="using:Tittle.Shared"
        xmlns:core="using:Tittle.Core.Abstractions"
        xmlns:editing="using:Tittle.Core.Editing"
        xmlns:text="using:Tittle.Core.Text"
        xmlns:ui="using:FluentAvalonia.UI.Controls"
        xmlns:wnd="using:FluentAvalonia.UI.Windowing"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="750"
        x:Class="Tittle.Features.Shell.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding Title}"
        Icon="/Assets/tittle.png"
        Width="1100" Height="750"
        Background="{DynamicResource WindowBackgroundBrush}"
        TransparencyLevelHint="None"
        DragDrop.AllowDrop="True">
  <wnd:AppWindow.Styles>
    <!-- At a phone-width window the status strip cannot fit every optional metric and action without
         making the DockPanel overlap. The commands remain available through shortcuts/palette; hide
         only this secondary chrome while preserving the strip itself and its height. -->
    <Style Selector="Border.compact-status TextBlock.status-optional,
                     Border.compact-status StackPanel.status-optional,
                     Border.compact-status Panel.status-optional,
                     Border.compact-status Button.status-optional,
                     Border.compact-status Border.status-optional">
      <Setter Property="IsVisible" Value="False"/>
    </Style>
    <!-- Below the compact workspace threshold the rail stays as the navigation anchor, while the
         contextual pane collapses to give the document a usable reading canvas. The user's chosen
         section/width is retained and returns when the window grows again. -->
    <Style Selector="Grid.compact-workspace GridSplitter">
      <Setter Property="IsVisible" Value="False"/>
    </Style>
    <!-- Omnibar address field: a borderless TextBox that blends into the omnibar pill (the outer Border
         already draws the box). Editable + selectable so the path can be copied or replaced (Enter opens
         it; see code-behind). We flatten the FluentAvalonia template's PART_BorderElement across all
         states so no inner box/border appears on hover/focus. -->
    <Style Selector="TextBox.omnibar-input">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="MinHeight" Value="0"/>
      <Setter Property="Padding" Value="2,2"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Foreground" Value="{DynamicResource ChromeForegroundBrush}"/>
    </Style>
    <Style Selector="TextBox.omnibar-input /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="TextBox.omnibar-input:pointerover /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="TextBox.omnibar-input:focus /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="Border.omnibar-shell">
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="{DynamicResource DurFast}"/>
          <BrushTransition Property="BorderBrush" Duration="{DynamicResource DurFast}"/>
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.omnibar-shell:pointerover">
      <Setter Property="BorderBrush" Value="{DynamicResource ChromeForegroundMutedBrush}"/>
    </Style>
    <Style Selector="Border.omnibar-shell.focused">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
      <Setter Property="Background" Value="{DynamicResource WorkspaceHeaderBackgroundBrush}"/>
    </Style>
  </wnd:AppWindow.Styles>
  <!-- One 40px window header above a three-region workspace: rail, contextual sidebar, document.
       The system caption buttons occupy the reserved right header column. -->
  <Grid x:Name="ShellGrid" RowDefinitions="40,*">

    <!-- Title strip wrapped in a Border so it casts a soft shadow onto the body below
         (ZIndex keeps the shadow above the editor/welcome content). -->
    <Border Grid.Row="0" ZIndex="1" BoxShadow="{DynamicResource ChromeShadow}">
    <Panel>
    <!-- Chrome fill on a hit-test-invisible layer so the empty title-bar zones still drag the
         window — a non-null Background on the Grid itself swallows the AppWindow drag. -->
    <Border Background="{DynamicResource WorkspaceHeaderBackgroundBrush}" IsHitTestVisible="False"/>
    <!-- Col3 reserves the system caption-button band. Its Width is set on the COLUMN (not on a child
         Border) in code-behind from TitleBar.RightInset: an Auto column fed by a child's late-set
         Width does not re-distribute the star omnibar column, leaving the reserve at 0 and the
         right-hand cluster sliding under min/max/close. Sizing the ColumnDefinition directly is the
         canonical WinUI/FluentAvalonia padding-column pattern and always reflows correctly. -->
    <Grid x:Name="TitleGrid" MinHeight="40"
          AutomationProperties.AutomationId="WorkspaceHeader">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
        <!-- [3] caption-button reserve — Width set from code-behind (TitleGrid.ColumnDefinitions[3]). -->
        <ColumnDefinition Width="0"/>
      </Grid.ColumnDefinitions>
      <!-- ☰ menu — the etalon default (MenuPlacement.Hidden). Replaces the "Tittle" wordmark
           (which crowded the tabs) and gathers File/View commands. First real consumer of Layout:
           shown only for the Hidden placement (Bar / TitleBar presets arrive with Settings → Layout).
           AllowInteractionInTitleBar so the click opens the flyout instead of dragging the window.
           Standard Avalonia MenuFlyout/MenuItem — FluentAvalonia themes them to match the chrome. -->
      <Button Grid.Column="0" AutomationProperties.AutomationId="MenuButton"
              AutomationProperties.Name="Меню" ToolTip.Tip="Меню"
              Classes="chrome-menu" Margin="6,0,2,0" VerticalAlignment="Center"
              wnd:AppWindow.AllowInteractionInTitleBar="True"
              IsVisible="{Binding Layout.MenuPlacement, Converter={x:Static conv:EnumToBoolConverter.Instance}, ConverterParameter=Hidden}">
        <PathIcon Data="{StaticResource IconMenu}" Width="17" Height="17"/>
        <Button.Flyout>
          <MenuFlyout Placement="BottomEdgeAlignedLeft">
            <MenuItem Header="Файл">
              <MenuItem Header="Открыть…" InputGesture="Ctrl+O" Command="{Binding OpenFileCommand}"/>
              <MenuItem Header="Открыть пример" Command="{Binding OpenSampleCommand}"/>
              <MenuItem Header="Недавние" IsEnabled="{Binding HasRecent}" ItemsSource="{Binding RecentItems}">
                <MenuItem.ItemContainerTheme>
                  <ControlTheme TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}"
                                x:DataType="vm:RecentFileItem">
                    <Setter Property="Header" Value="{Binding Name}"/>
                    <Setter Property="Command" Value="{Binding OpenCommand}"/>
                    <Setter Property="ToolTip.Tip" Value="{Binding Path}"/>
                  </ControlTheme>
                </MenuItem.ItemContainerTheme>
              </MenuItem>
              <Separator/>
              <MenuItem Header="Сохранить" InputGesture="Ctrl+S" Command="{Binding SaveActiveTabCommand}"
                        IsEnabled="{Binding HasTabs}"/>
              <Separator/>
              <MenuItem Header="Экспорт в HTML…" Command="{Binding ExportHtmlCommand}"
                        IsEnabled="{Binding SelectedTab.IsMarkdown, FallbackValue=False}"/>
              <MenuItem Header="Копировать как форматированный текст" Command="{Binding CopyAsRichTextCommand}"
                        IsEnabled="{Binding SelectedTab.IsMarkdown, FallbackValue=False}"/>
              <MenuItem Header="Печать / PDF (через браузер)…" Command="{Binding PrintViaBrowserCommand}"
                        IsEnabled="{Binding SelectedTab.IsMarkdown, FallbackValue=False}"/>
              <Separator/>
              <MenuItem Header="Закрыть вкладку" InputGesture="Ctrl+W" Command="{Binding CloseActiveTabCommand}"/>
            </MenuItem>
            <MenuItem Header="Правка">
              <MenuItem Header="Найти…" InputGesture="Ctrl+F" Command="{Binding SelectedTab.OpenSearchCommand}"/>
              <MenuItem Header="Заменить…" InputGesture="Ctrl+H" Command="{Binding SelectedTab.OpenReplaceCommand}"/>
              <Separator/>
              <MenuItem Header="Сортировать строки (А→Я)" Command="{Binding SelectedTab.ApplyLineOpCommand}"
                        CommandParameter="{x:Static editing:LineOp.SortAscending}"/>
              <MenuItem Header="Сортировать строки (Я→А)" Command="{Binding SelectedTab.ApplyLineOpCommand}"
                        CommandParameter="{x:Static editing:LineOp.SortDescending}"/>
              <MenuItem Header="Удалить дубликаты строк" Command="{Binding SelectedTab.ApplyLineOpCommand}"
                        CommandParameter="{x:Static editing:LineOp.RemoveDuplicates}"/>
              <MenuItem Header="Убрать хвостовые пробелы" Command="{Binding SelectedTab.ApplyLineOpCommand}"
                        CommandParameter="{x:Static editing:LineOp.TrimTrailing}"/>
              <Separator/>
              <MenuItem Header="ВЕРХНИЙ РЕГИСТР" Command="{Binding SelectedTab.ApplyLineOpCommand}"
                        CommandParameter="{x:Static editing:LineOp.Upper}"/>
              <MenuItem Header="нижний регистр" Command="{Binding SelectedTab.ApplyLineOpCommand}"
                        CommandParameter="{x:Static editing:LineOp.Lower}"/>
              <MenuItem Header="Заголовочный Регистр" Command="{Binding SelectedTab.ApplyLineOpCommand}"
                        CommandParameter="{x:Static editing:LineOp.Title}"/>
              <Separator/>
              <MenuItem Header="Переместить строку вверх" InputGesture="Alt+Up"
                        Command="{Binding SelectedTab.ApplyLineOpCommand}"
                        CommandParameter="{x:Static editing:LineOp.MoveUp}"/>
              <MenuItem Header="Переместить строку вниз" InputGesture="Alt+Down"
                        Command="{Binding SelectedTab.ApplyLineOpCommand}"
                        CommandParameter="{x:Static editing:LineOp.MoveDown}"/>
              <MenuItem Header="Дублировать строку" InputGesture="Ctrl+D"
                        Command="{Binding SelectedTab.ApplyLineOpCommand}"
                        CommandParameter="{x:Static editing:LineOp.Duplicate}"/>
              <MenuItem Header="Объединить строки" Command="{Binding SelectedTab.ApplyLineOpCommand}"
                        CommandParameter="{x:Static editing:LineOp.Join}"/>
              <Separator/>
              <MenuItem Header="Конец строк">
                <MenuItem Header="LF (Unix)" Command="{Binding SelectedTab.ApplyEolCommand}"
                          CommandParameter="{x:Static text:Eol.Lf}"/>
                <MenuItem Header="CRLF (Windows)" Command="{Binding SelectedTab.ApplyEolCommand}"
                          CommandParameter="{x:Static text:Eol.CrLf}"/>
                <MenuItem Header="CR (Mac classic)" Command="{Binding SelectedTab.ApplyEolCommand}"
                          CommandParameter="{x:Static text:Eol.Cr}"/>
              </MenuItem>
              <MenuItem Header="Кодировка (сохранять как)">
                <MenuItem Header="UTF-8" Command="{Binding SelectedTab.SetSaveEncodingCommand}" CommandParameter="UTF-8"/>
                <MenuItem Header="UTF-8 с BOM" Command="{Binding SelectedTab.SetSaveEncodingCommand}" CommandParameter="UTF-8 BOM"/>
                <MenuItem Header="UTF-16 LE" Command="{Binding SelectedTab.SetSaveEncodingCommand}" CommandParameter="UTF-16 LE"/>
                <MenuItem Header="UTF-16 BE" Command="{Binding SelectedTab.SetSaveEncodingCommand}" CommandParameter="UTF-16 BE"/>
                <MenuItem Header="Windows-1251" Command="{Binding SelectedTab.SetSaveEncodingCommand}" CommandParameter="Windows-1251"/>
              </MenuItem>
              <MenuItem Header="Переинтерпретировать как">
                <MenuItem Header="UTF-8" Command="{Binding ReinterpretEncodingCommand}" CommandParameter="UTF-8"/>
                <MenuItem Header="UTF-8 с BOM" Command="{Binding ReinterpretEncodingCommand}" CommandParameter="UTF-8 BOM"/>
                <MenuItem Header="UTF-16 LE" Command="{Binding ReinterpretEncodingCommand}" CommandParameter="UTF-16 LE"/>
                <MenuItem Header="UTF-16 BE" Command="{Binding ReinterpretEncodingCommand}" CommandParameter="UTF-16 BE"/>
                <MenuItem Header="Windows-1251" Command="{Binding ReinterpretEncodingCommand}" CommandParameter="Windows-1251"/>
              </MenuItem>
            </MenuItem>
            <MenuItem Header="Инструменты">
              <MenuItem Header="Записать макрос" Command="{Binding Macros.ToggleMacroRecordingCommand}"
                        IsVisible="{Binding !Macros.IsRecordingMacro}"/>
              <MenuItem Header="Остановить запись" Command="{Binding Macros.ToggleMacroRecordingCommand}"
                        IsVisible="{Binding Macros.IsRecordingMacro}"/>
              <MenuItem Header="Воспроизвести макрос" Command="{Binding Macros.PlayMacroCommand}"
                        IsEnabled="{Binding Macros.HasMacro}"/>
              <MenuItem Header="Воспроизвести до конца файла" Command="{Binding Macros.PlayMacroToEndCommand}"
                        IsEnabled="{Binding Macros.HasMacro}"/>
              <Separator/>
              <MenuItem Header="Управление макросами…" Command="{Binding Macros.ShowMacroManagerCommand}"/>
            </MenuItem>
            <MenuItem Header="Вид">
              <MenuItem Header="Тема">
                <MenuItem Header="Тёмная" ToggleType="Radio" GroupName="Theme"
                          Command="{Binding SetThemeCommand}" CommandParameter="{x:Static core:ThemeMode.Dark}"
                          IsChecked="{Binding CurrentTheme, Mode=OneWay, Converter={x:Static conv:EnumToBoolConverter.Instance}, ConverterParameter=Dark}"/>
                <MenuItem Header="Полночь" ToggleType="Radio" GroupName="Theme"
                          Command="{Binding SetThemeCommand}" CommandParameter="{x:Static core:ThemeMode.Midnight}"
                          IsChecked="{Binding CurrentTheme, Mode=OneWay, Converter={x:Static conv:EnumToBoolConverter.Instance}, ConverterParameter=Midnight}"/>
                <MenuItem Header="Океан" ToggleType="Radio" GroupName="Theme"
                          Command="{Binding SetThemeCommand}" CommandParameter="{x:Static core:ThemeMode.Ocean}"
                          IsChecked="{Binding CurrentTheme, Mode=OneWay, Converter={x:Static conv:EnumToBoolConverter.Instance}, ConverterParameter=Ocean}"/>
                <MenuItem Header="Глубокий синий" ToggleType="Radio" GroupName="Theme"
                          Command="{Binding SetThemeCommand}" CommandParameter="{x:Static core:ThemeMode.DeepBlue}"
                          IsChecked="{Binding CurrentTheme, Mode=OneWay, Converter={x:Static conv:EnumToBoolConverter.Instance}, ConverterParameter=DeepBlue}"/>
                <MenuItem Header="Светлая" ToggleType="Radio" GroupName="Theme"
                          Command="{Binding SetThemeCommand}" CommandParameter="{x:Static core:ThemeMode.Light}"
                          IsChecked="{Binding CurrentTheme, Mode=OneWay, Converter={x:Static conv:EnumToBoolConverter.Instance}, ConverterParameter=Light}"/>
                <MenuItem Header="Авто" ToggleType="Radio" GroupName="Theme"
                          Command="{Binding SetThemeCommand}" CommandParameter="{x:Static core:ThemeMode.Auto}"
                          IsChecked="{Binding CurrentTheme, Mode=OneWay, Converter={x:Static conv:EnumToBoolConverter.Instance}, ConverterParameter=Auto}"/>
              </MenuItem>
              <Separator/>
              <MenuItem Header="Перенос строк" InputGesture="Alt+Z" ToggleType="CheckBox"
                        IsChecked="{Binding Editor.WordWrap, Mode=TwoWay}"/>
              <MenuItem Header="Номера строк" InputGesture="Ctrl+L" ToggleType="CheckBox"
                        IsChecked="{Binding Editor.ShowLineNumbers, Mode=TwoWay}"/>
              <Separator/>
              <MenuItem Header="Перейти к строке…" InputGesture="Ctrl+G" Command="{Binding OpenGoToLineCommand}"/>
              <Separator/>
              <MenuItem Header="Раскладка…" Command="{Binding OpenLayoutSettingsCommand}"/>
            </MenuItem>
            <MenuItem Header="Справка">
              <MenuItem Header="Горячие клавиши" InputGesture="F1" Command="{Binding ShowHelpCommand}"/>
              <MenuItem Header="Статистика документа" Command="{Binding ShowStatsCommand}"/>
              <Separator/>
              <MenuItem Header="Поддержать автора…" Command="{Binding ShowDonateCommand}"/>
            </MenuItem>
          </MenuFlyout>
        </Button.Flyout>
      </Button>

      <!-- Omnibar (etalon header): active document path · 📂 Open · ⌘ palette, in a slim inset field.
           Toggled by Layout.ShowOmnibar. AllowInteractionInTitleBar so its buttons click; the empty
           title area around it (it is centred + width-capped) still drags the window. -->
      <Border Grid.Column="1" x:Name="Omnibar" Classes="omnibar-shell" AutomationProperties.AutomationId="Omnibar"
              IsVisible="{Binding Layout.ShowOmnibar}"
              wnd:AppWindow.AllowInteractionInTitleBar="True"
              Background="{DynamicResource EditorSurfaceBrush}" CornerRadius="6"
              BorderBrush="{DynamicResource ChromeBorderBrush}" BorderThickness="1"
              HorizontalAlignment="Center" MinWidth="340" MaxWidth="760"
              Margin="8,6" Padding="3,1" VerticalAlignment="Center">
        <DockPanel>
          <Button DockPanel.Dock="Left" Classes="chrome-menu" ToolTip.Tip="Открыть файл (Ctrl+O)"
                  AutomationProperties.Name="Открыть файл"
                  Command="{Binding OpenFileCommand}" Padding="6,3">
            <PathIcon Data="{StaticResource IconFolderOpen}" Width="16" Height="16"/>
          </Button>
          <Button DockPanel.Dock="Right" Classes="chrome-menu" ToolTip.Tip="Команды (Ctrl+K · Ctrl+Shift+P)"
                   AutomationProperties.Name="Палитра команд"
                   Click="OnPaletteButtonClick" Padding="8,3">
            <PathIcon Data="{StaticResource IconCommand}" Width="16" Height="16"/>
          </Button>
          <!-- Editable address field: shows the active document's path (selectable → copy), and opening
               another path is just typing it and pressing Enter (Esc reverts). Enter/Esc are handled in
               code-behind on this named box; the text mirrors the VM's OmnibarText scratch buffer. -->
          <TextBox x:Name="OmnibarBox" Classes="omnibar-input" Margin="6,0"
                   Text="{Binding OmnibarText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                   Watermark="Путь к файлу…" AutomationProperties.Name="Адрес файла"
                   ToolTip.Tip="Путь к файлу — Enter открывает, Esc отменяет"/>
        </DockPanel>
      </Border>

    </Grid>
    </Panel>
    </Border>

    <Grid x:Name="BodyGrid" Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="44"/>
        <!-- [1] persisted contextual-sidebar width; code-behind collapses it to zero. -->
        <ColumnDefinition Width="240" MinWidth="180" MaxWidth="480"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <workspace:WorkspaceRail Grid.Column="0"
                               AutomationProperties.AutomationId="WorkspaceRail"
                               CommandPaletteRequested="OnWorkspaceCommandPaletteRequested"/>
      <workspace:WorkspaceSidebar Grid.Column="1"
                                  AutomationProperties.AutomationId="WorkspaceSidebar"
                                  IsVisible="{Binding IsWorkspaceSidebarVisible}"/>
      <GridSplitter Grid.Column="2" AutomationProperties.AutomationId="WorkspaceSplitter"
                    ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                    Width="5" Background="Transparent" Cursor="SizeWestEast"
                    IsVisible="{Binding IsWorkspaceSidebarVisible}"/>

      <DockPanel Grid.Column="3" LastChildFill="True">

    <!-- Tabs and contextual document actions share one compact header: no extra toolbar band. -->
    <Border DockPanel.Dock="Top" IsVisible="{Binding IsDocumentHeaderVisible}"
            AutomationProperties.AutomationId="DocumentHeader"
            Background="{DynamicResource WorkspaceHeaderBackgroundBrush}"
            BorderBrush="{DynamicResource WorkspaceSeparatorBrush}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <!-- Settings "tab" chip: sits in the tab strip while the settings page is open, styled like an
             active VS-Code tab (accent top border). ✕ closes it; clicking any document tab also closes it. -->
        <Border Grid.Column="0" IsVisible="{Binding IsSettingsOpen}"
                VerticalAlignment="Bottom" Margin="4,0,2,0" Padding="10,6,6,6"
                Background="{DynamicResource EditorSurfaceBrush}"
                BorderBrush="{DynamicResource AccentBrush}" BorderThickness="0,2,0,0"
                AutomationProperties.AutomationId="SettingsTab">
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <PathIcon Data="{StaticResource IconSettings}" Width="14" Height="14" VerticalAlignment="Center"/>
            <TextBlock Text="Настройки" VerticalAlignment="Center"/>
            <Button Classes="statusbtn" Command="{Binding CloseSettingsCommand}"
                    ToolTip.Tip="Закрыть настройки" AutomationProperties.Name="Закрыть настройки"
                    Content="✕" FontSize="11" Padding="4,0" VerticalAlignment="Center"/>
          </StackPanel>
        </Border>
        <ListBox x:Name="TabStrip" Grid.Column="1" ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab}"
               ItemContainerTheme="{StaticResource VsCodeTab}"
               Background="Transparent" BorderThickness="0" Padding="0"
               HorizontalAlignment="Stretch" VerticalAlignment="Bottom"
               ScrollViewer.HorizontalScrollBarVisibility="Auto"
               ScrollViewer.VerticalScrollBarVisibility="Disabled"
               ScrollViewer.AllowAutoHide="True">
        <ListBox.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal"/>
          </ItemsPanelTemplate>
        </ListBox.ItemsPanel>
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:DocumentTabViewModel">
            <!-- Hover shows the full path (#30); right-click opens the tab context menu (#25). The menu's
                 commands live on the shell VM and are reached via the tab's Shell back-reference — a
                 context flyout is a popup, so its bindings can't walk the visual tree up to the shell. -->
            <StackPanel Orientation="Horizontal" Spacing="6" ToolTip.Tip="{Binding FilePath}">
              <StackPanel.ContextFlyout>
                <MenuFlyout>
                  <MenuItem Header="Закрыть" Command="{Binding Shell.CloseTabCommand}" CommandParameter="{Binding}"/>
                  <MenuItem Header="Закрыть другие" Command="{Binding Shell.CloseOtherTabsCommand}" CommandParameter="{Binding}"/>
                  <MenuItem Header="Закрыть справа" Command="{Binding Shell.CloseTabsToRightCommand}" CommandParameter="{Binding}"/>
                  <MenuItem Header="Закрыть все" Command="{Binding Shell.CloseAllTabsCommand}"/>
                  <Separator/>
                  <MenuItem Header="Копировать путь" Command="{Binding Shell.CopyFilePathCommand}" CommandParameter="{Binding}"/>
                  <MenuItem Header="Копировать имя" Command="{Binding Shell.CopyFileNameCommand}" CommandParameter="{Binding}"/>
                  <Separator/>
                  <MenuItem Header="Перезагрузить с диска" Command="{Binding Shell.ReloadTabCommand}" CommandParameter="{Binding}"/>
                  <MenuItem Header="Показать в проводнике" Command="{Binding Shell.RevealInExplorerCommand}" CommandParameter="{Binding}"/>
                </MenuFlyout>
              </StackPanel.ContextFlyout>
              <PathIcon Width="15" Height="15" VerticalAlignment="Center"
                        Data="{Binding GrammarExtension, Converter={x:Static conv:ExtensionToIconConverter.Instance}}"/>
              <!-- Cap the title and ellipsize it (full name is in the tab tooltip): an unbounded
                   header let a long filename stretch the tab past the strip width, which tripped the
                   ListBox's horizontal scrollbar. VS Code-style variable-width tabs. -->
              <TextBlock Text="{Binding Header}" VerticalAlignment="Center"
                         MaxWidth="200" TextTrimming="CharacterEllipsis"/>
              <!-- "Changed on disk" dot (M14): an external edit happened since this tab loaded. -->
              <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                       Fill="{DynamicResource AccentBrush}"
                       IsVisible="{Binding IsChangedOnDisk}"
                       ToolTip.Tip="Файл изменён на диске"/>
              <!-- Unsaved-changes marker (M15): the editor buffer differs from the file. -->
              <TextBlock Text="●" FontSize="9" VerticalAlignment="Center"
                         Foreground="{DynamicResource ChromeForegroundMutedBrush}"
                         IsVisible="{Binding IsEdited}"
                         ToolTip.Tip="Есть несохранённые правки (Ctrl+S)"/>
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4"
                    VerticalAlignment="Center" Margin="6,2,8,2"
                    IsVisible="{Binding !IsSettingsOpen}">
          <!-- Source-only tools occupy the same row as tabs. Off mode keeps wrap/numbers in status.
               Hidden while the settings page is open (those actions target the hidden document). -->
          <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
            <StackPanel.IsVisible>
              <MultiBinding Converter="{x:Static conv:ToolbarVisibilityConverter.Instance}" ConverterParameter="toolbar">
                <Binding Path="Layout.ToolbarMode"/>
                <Binding Path="SelectedTab.ShowSource" FallbackValue="False"/>
                <Binding Path="HasTabs"/>
              </MultiBinding>
            </StackPanel.IsVisible>
            <Button Command="{Binding OpenSearchCommand}" ToolTip.Tip="Найти (Ctrl+F)"
                    AutomationProperties.Name="Найти" Classes="header-action">
              <PathIcon Data="{StaticResource IconSearch}" Width="15" Height="15"/>
            </Button>

            <!-- Markdown formatting cluster (part ④): wrap/prefix the selection with markdown syntax via the
                 command-intent backbone (so it's macro-recordable). Markdown-only — the buttons are meaningless
                 in .json/.txt source. NB no alignment buttons: markdown has no paragraph-alignment syntax. -->
            <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center"
                        IsVisible="{Binding SelectedTab.IsMarkdown, FallbackValue=False}">
              <Button Classes="statusbtn" Command="{Binding SelectedTab.MarkdownFormatCommand}"
                      CommandParameter="{x:Static text:MarkdownFormatKind.Bold}"
                      ToolTip.Tip="Жирный" AutomationProperties.Name="Жирный">
                <TextBlock Text="Ж" FontWeight="Bold" FontSize="13"/>
              </Button>
              <Button Classes="statusbtn" Command="{Binding SelectedTab.MarkdownFormatCommand}"
                      CommandParameter="{x:Static text:MarkdownFormatKind.Italic}"
                      ToolTip.Tip="Курсив" AutomationProperties.Name="Курсив">
                <TextBlock Text="К" FontStyle="Italic" FontSize="13"/>
              </Button>
              <Button Classes="statusbtn" Command="{Binding SelectedTab.MarkdownFormatCommand}"
                      CommandParameter="{x:Static text:MarkdownFormatKind.Code}"
                      ToolTip.Tip="Моноширинный код" AutomationProperties.Name="Код">
                <PathIcon Data="{StaticResource IconCode}" Width="15" Height="15"/>
              </Button>
              <Button Classes="statusbtn" Command="{Binding SelectedTab.MarkdownFormatCommand}"
                      CommandParameter="{x:Static text:MarkdownFormatKind.Link}"
                      ToolTip.Tip="Ссылка" AutomationProperties.Name="Ссылка">
                <PathIcon Data="{StaticResource IconExternalLink}" Width="15" Height="15"/>
              </Button>
              <Button Classes="statusbtn" Command="{Binding SelectedTab.MarkdownFormatCommand}"
                      CommandParameter="{x:Static text:MarkdownFormatKind.Heading}"
                      ToolTip.Tip="Заголовок (уровень +1)" AutomationProperties.Name="Заголовок">
                <TextBlock Text="#" FontWeight="SemiBold" FontSize="14"/>
              </Button>
              <Button Classes="statusbtn" Command="{Binding SelectedTab.MarkdownFormatCommand}"
                      CommandParameter="{x:Static text:MarkdownFormatKind.Quote}"
                      ToolTip.Tip="Цитата" AutomationProperties.Name="Цитата">
                <TextBlock Text="„" FontSize="16"/>
              </Button>
              <Button Classes="statusbtn" Command="{Binding SelectedTab.MarkdownFormatCommand}"
                      CommandParameter="{x:Static text:MarkdownFormatKind.BulletList}"
                      ToolTip.Tip="Маркированный список" AutomationProperties.Name="Список">
                <TextBlock Text="•" FontSize="15"/>
              </Button>
              <Border Width="1" Margin="4,3" Background="{DynamicResource WorkspaceSeparatorBrush}"/>
            </StackPanel>

            <vm:EditorToggleCluster/>
            <Button Command="{Binding SelectedTab.TogglePrettyPrintCommand}"
                    ToolTip.Tip="Форматировать (JSON / XML / NDJSON)"
                    AutomationProperties.Name="Форматировать" Content="{}" Classes="header-action"
                    IsVisible="{Binding SelectedTab.IsPrettyPrintable, FallbackValue=False}"/>
            <Border Width="1" Margin="4,3" Background="{DynamicResource WorkspaceSeparatorBrush}"
                    IsVisible="{Binding SelectedTab.IsMarkdown, FallbackValue=False}"/>
          </StackPanel>

          <!-- One three-way mode control: Reading / Source / Split — icon + label (VS-Code-ish). -->
          <Border Classes="segmented" AutomationProperties.AutomationId="ViewModeSwitch"
                  IsVisible="{Binding SelectedTab.IsMarkdown, FallbackValue=False}">
            <StackPanel Orientation="Horizontal">
              <Button Classes="segment"
                      AutomationProperties.AutomationId="ViewModePreview"
                      AutomationProperties.Name="Режим чтения" ToolTip.Tip="Чтение"
                      Classes.seg-on="{Binding SelectedTab.ShowPreview, FallbackValue=False}"
                      Command="{Binding SelectedTab.ShowPreviewModeCommand}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <PathIcon Data="{StaticResource IconDocument}" Width="13" Height="13"/>
                  <TextBlock Text="Чтение"/>
                </StackPanel>
              </Button>
              <Button Classes="segment"
                      AutomationProperties.AutomationId="ViewModeSource"
                      AutomationProperties.Name="Режим исходника" ToolTip.Tip="Исходник"
                      Classes.seg-on="{Binding SelectedTab.ShowSource, FallbackValue=False}"
                      Command="{Binding SelectedTab.ShowSourceModeCommand}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <PathIcon Data="{StaticResource IconCode}" Width="13" Height="13"/>
                  <TextBlock Text="Исходник"/>
                </StackPanel>
              </Button>
              <Button Classes="segment"
                      AutomationProperties.AutomationId="ViewModeSplit"
                      AutomationProperties.Name="Разделённый вид" ToolTip.Tip="Разделённый"
                      Classes.seg-on="{Binding SelectedTab.ShowSplit, FallbackValue=False}"
                      Command="{Binding SelectedTab.ToggleSplitCommand}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <PathIcon Data="{StaticResource IconSplitColumns}" Width="13" Height="13"/>
                  <TextBlock Text="Разделённый"/>
                </StackPanel>
              </Button>
            </StackPanel>
          </Border>

          <!-- Split-orientation flip (VS-Code layout icon): shown only in split mode; the glyph reflects the
               current orientation and clicking toggles it. Command is on the shell VM (Layout is shared). -->
          <Button Classes="header-action" Margin="6,0,0,0"
                  IsVisible="{Binding SelectedTab.ShowSplit, FallbackValue=False}"
                  Command="{Binding ToggleSplitOrientationCommand}"
                  AutomationProperties.AutomationId="SplitOrientationFlip"
                  AutomationProperties.Name="Повернуть разделение"
                  ToolTip.Tip="Повернуть разделение (рядом ↔ друг над другом)">
            <Panel>
              <PathIcon Data="{StaticResource IconSplitColumns}" Width="15" Height="15"
                        IsVisible="{Binding SelectedTab.Layout.SplitOrientation, Converter={x:Static conv:EnumToBoolConverter.Instance}, ConverterParameter=Horizontal, FallbackValue=True}"/>
              <PathIcon Data="{StaticResource IconSplitRows}" Width="15" Height="15"
                        IsVisible="{Binding SelectedTab.Layout.SplitOrientation, Converter={x:Static conv:EnumToBoolConverter.Instance}, ConverterParameter=Vertical, FallbackValue=False}"/>
            </Panel>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Open-error InfoBar (#28): a prominent strip above the content — the status-bar message
         alone is easy to miss. The VM auto-dismisses it after ~7 s; the built-in ✕ writes
         IsOpen=false back through the two-way binding. -->
    <ui:InfoBar DockPanel.Dock="Top" Severity="Error" IsClosable="True"
                IsOpen="{Binding IsErrorBarOpen, Mode=TwoWay}"
                Message="{Binding ErrorBarMessage}"
                AutomationProperties.Name="Ошибка открытия файла"/>

    <!-- Update-ready InfoBar (Velopack): a downloaded update is staged; Перезапустить applies it and
         restarts. Persistent (no auto-dismiss) so the user can act when they like. -->
    <ui:InfoBar DockPanel.Dock="Top" Severity="Success" IsClosable="True"
                IsOpen="{Binding IsUpdateBannerOpen, Mode=TwoWay}"
                Message="{Binding UpdateBannerMessage}"
                AutomationProperties.Name="Доступно обновление">
      <ui:InfoBar.ActionButton>
        <Button Content="Перезапустить" Command="{Binding RestartToUpdateCommand}"/>
      </ui:InfoBar.ActionButton>
    </ui:InfoBar>

    <!-- 24px document-state strip: messages, position, encoding/metrics, zoom and format actions. -->
    <Border DockPanel.Dock="Bottom" x:Name="WorkspaceStatusStrip" Classes="chrome" Height="24"
            AutomationProperties.AutomationId="WorkspaceStatusStrip"
            Background="{DynamicResource StatusBarBackgroundBrush}" Padding="{DynamicResource StatusBarPadding}">
      <DockPanel>
        <Panel DockPanel.Dock="Right" Classes="status-optional">
          <TextBlock Text="{Binding SelectedTab.StatusText}"
                     IsVisible="{Binding HasTabs}"
                     Foreground="{DynamicResource StatusBarForegroundBrush}" FontSize="11.5"
                     Opacity="0.92" VerticalAlignment="Center"/>
        </Panel>
        <!-- Selection word count (ported) — empty text collapses to nothing. -->
        <Panel DockPanel.Dock="Right" Classes="status-optional">
          <TextBlock Text="{Binding SelectedTab.SelectionInfo, FallbackValue=''}"
                     Margin="0,0,12,0" Foreground="{DynamicResource StatusBarForegroundBrush}"
                     FontSize="11.5" Opacity="0.92" VerticalAlignment="Center"/>
        </Panel>
        <!-- Scroll position (ported) — "NN%" through the document, both view modes. -->
        <Panel DockPanel.Dock="Right" Classes="status-optional">
          <TextBlock Text="{Binding SelectedTab.ScrollPercentText, FallbackValue=''}"
                     Margin="0,0,12,0" Foreground="{DynamicResource StatusBarForegroundBrush}"
                     FontSize="11.5" Opacity="0.92" VerticalAlignment="Center"/>
        </Panel>
        <!-- Caret position — only meaningful (and shown) while the source editor is visible. -->
        <Panel DockPanel.Dock="Right" Classes="status-optional">
          <TextBlock Text="{Binding SelectedTab.CaretText}"
                     IsVisible="{Binding SelectedTab.ShowSource, FallbackValue=False}" Margin="0,0,12,0"
                     Foreground="{DynamicResource StatusBarForegroundBrush}" FontSize="11.5"
                     Opacity="0.92" VerticalAlignment="Center"/>
        </Panel>
        <!-- PDF page counter «стр N / M» — written by PdfView from the scroll position. -->
        <Panel DockPanel.Dock="Right" Classes="status-optional">
          <TextBlock Text="{Binding SelectedTab.PdfPageText}"
                     IsVisible="{Binding SelectedTab.ShowPdf, FallbackValue=False}" Margin="0,0,12,0"
                     Foreground="{DynamicResource StatusBarForegroundBrush}" FontSize="11.5"
                     Opacity="0.92" VerticalAlignment="Center"/>
        </Panel>
        <!-- Zoom — in the status bar for the source editor AND the markdown preview (the preview is
             scaled via a layout transform by the same font-size value). Hidden for table/notice tabs. -->
        <Panel DockPanel.Dock="Right" Classes="status-optional">
          <StackPanel Orientation="Horizontal" Spacing="2" Margin="0,0,10,0"
                      VerticalAlignment="Center" IsVisible="{Binding SelectedTab.ZoomApplies, FallbackValue=False}">
            <Button Command="{Binding ZoomOutCommand}" ToolTip.Tip="Меньше (Ctrl+−)"
                    AutomationProperties.Name="Уменьшить шрифт" Content="A−" Classes="statusbtn"/>
            <Button Command="{Binding ZoomResetCommand}" ToolTip.Tip="Сбросить масштаб (Ctrl+0)"
                    AutomationProperties.Name="Размер шрифта" Content="{Binding Editor.FontSize}" Classes="statusbtn"/>
            <Button Command="{Binding ZoomInCommand}" ToolTip.Tip="Больше (Ctrl++)"
                    AutomationProperties.Name="Увеличить шрифт" Content="A+" Classes="statusbtn"/>
          </StackPanel>
        </Panel>
        <!-- Wrap · numbers FALLBACK — shown here only when ToolbarMode is Off; otherwise they live in the
             contextual toolbar above (the converter keeps them in exactly one place). -->
        <Panel DockPanel.Dock="Right" Classes="status-optional">
          <StackPanel Orientation="Horizontal" Spacing="2" Margin="0,0,4,0"
                      VerticalAlignment="Center">
            <StackPanel.IsVisible>
              <MultiBinding Converter="{x:Static conv:ToolbarVisibilityConverter.Instance}" ConverterParameter="statusfallback">
                <Binding Path="Layout.ToolbarMode"/>
                <Binding Path="SelectedTab.ShowSource" FallbackValue="False"/>
                <Binding Path="HasTabs"/>
              </MultiBinding>
            </StackPanel.IsVisible>
            <vm:EditorToggleCluster/>
          </StackPanel>
        </Panel>
        <!-- Table/source toggle for delimited files (ported csv-as-table) — in the status bar,
             which stays visible in both views (the contextual toolbar hides with the editor). -->
        <Panel DockPanel.Dock="Right" Classes="status-optional">
            <Button Classes="statusbtn" Margin="0,0,6,0"
                  Command="{Binding SelectedTab.ToggleCsvViewCommand}"
                  ToolTip.Tip="Таблица / исходник" AutomationProperties.Name="Таблица или исходник"
                  IsVisible="{Binding SelectedTab.CsvTable, FallbackValue=False, Converter={x:Static ObjectConverters.IsNotNull}}">
            <PathIcon Data="{StaticResource IconTable}" Width="14" Height="14"/>
          </Button>
        </Panel>
        <!-- PDF fit-to-width ⟷ actual size (100%) toggle. -->
        <Panel DockPanel.Dock="Right" Classes="status-optional">
            <Button Classes="statusbtn" Margin="0,0,6,0"
                  Command="{Binding SelectedTab.TogglePdfFitCommand}"
                  ToolTip.Tip="По ширине / 100%" AutomationProperties.Name="Масштаб PDF"
                  IsVisible="{Binding SelectedTab.ShowPdf, FallbackValue=False}">
            <PathIcon Data="{StaticResource IconFit}" Width="14" Height="14"/>
          </Button>
        </Panel>
        <!-- Image: rotate 90° + fit/100% toggle. -->
        <Panel DockPanel.Dock="Right" Classes="status-optional">
            <Button Classes="statusbtn" Margin="0,0,6,0"
                  Command="{Binding SelectedTab.RotateImageCommand}"
                  ToolTip.Tip="Повернуть на 90°" AutomationProperties.Name="Повернуть изображение"
                  IsVisible="{Binding SelectedTab.ShowImage, FallbackValue=False}">
            <PathIcon Data="{StaticResource IconRotate}" Width="14" Height="14"/>
          </Button>
        </Panel>
        <Panel DockPanel.Dock="Right" Classes="status-optional">
            <Button Classes="statusbtn" Margin="0,0,6,0"
                  Command="{Binding SelectedTab.ToggleImageFitCommand}"
                  ToolTip.Tip="Вписать / 100%" AutomationProperties.Name="Масштаб изображения"
                  IsVisible="{Binding SelectedTab.ShowImage, FallbackValue=False}">
            <PathIcon Data="{StaticResource IconFit}" Width="14" Height="14"/>
          </Button>
        </Panel>
        <Panel DockPanel.Dock="Right" Classes="status-optional">
          <Border Width="1" Margin="10,1" IsVisible="{Binding HasTabs}"
                  Background="{DynamicResource StatusBarForegroundBrush}" Opacity="0.3"/>
        </Panel>
        <!-- Left segment: status messages, replaced by the go-to-line input (Ctrl+G) while open.
             Lives in the status bar (chrome) rather than over the editor, where an overlay won't
             repaint over AvaloniaEdit's GPU surface. -->
        <Panel>
          <Panel Classes="status-optional">
            <TextBlock Text="{Binding StatusText}" IsVisible="{Binding !SelectedTab.IsGoToLineOpen, FallbackValue=True}"
                       Foreground="{DynamicResource StatusBarForegroundBrush}" FontSize="11.5"
                       VerticalAlignment="Center"/>
          </Panel>
          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                      IsVisible="{Binding SelectedTab.IsGoToLineOpen, FallbackValue=False}">
            <TextBlock Text="Перейти к строке:" VerticalAlignment="Center"
                       IsVisible="{Binding !SelectedTab.IsPdf, FallbackValue=True}"
                       Foreground="{DynamicResource StatusBarForegroundBrush}" FontSize="11.5"/>
            <TextBlock Text="Перейти к странице:" VerticalAlignment="Center"
                       IsVisible="{Binding SelectedTab.IsPdf, FallbackValue=False}"
                       Foreground="{DynamicResource StatusBarForegroundBrush}" FontSize="11.5"/>
            <TextBox x:Name="GoToLineBox" Width="72" Height="22" Padding="6,1" FontSize="11.5"
                     AutomationProperties.Name="Номер строки"
                     Text="{Binding SelectedTab.GoToLineText}" VerticalAlignment="Center"/>
          </StackPanel>
        </Panel>
      </DockPanel>
    </Border>

        <Panel x:Name="DocumentHost" AutomationProperties.AutomationId="DocumentHost">
          <Border Background="{DynamicResource EditorSurfaceBrush}" IsHitTestVisible="False"/>
        <!-- Welcome view shown when no tabs are open (and not in settings). -->
        <views:WelcomeView IsVisible="{Binding IsWelcomeVisible}"/>
        <!-- Every open tab's DocumentView stays realized (overlapping in a Panel); only the active tab's
             is visible. Switching tabs toggles IsActive instead of re-templating, so the editor + TextMate
             install + the markdown visual tree survive across switches (no rebuild hitch on Ctrl+Tab). -->
        <ItemsControl ItemsSource="{Binding Tabs}" IsVisible="{Binding IsDocumentAreaVisible}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <Panel/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:DocumentTabViewModel">
              <controls:DocumentView IsVisible="{Binding IsActive}"
                                     HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <!-- Settings as an inline page. Mutually exclusive with Welcome/Tabs above (only one is visible at a
             time), so it never overlays a live AvaloniaEdit surface — which wouldn't repaint under an overlay. -->
        <settings:SettingsView IsVisible="{Binding IsSettingsOpen}"/>
        </Panel>

      </DockPanel>
    </Grid>
  </Grid>
</wnd:AppWindow>
