<Project Sdk="Microsoft.NET.Sdk">

  <!-- Pure logic library: models, abstractions, parsers, services.
       MUST NOT reference Avalonia or any UI controls (Core <-> UI boundary). -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Legacy code pages (Windows-1251 etc.) for encoding detection. -->
    <PackageReference Include="System.Text.Encoding.CodePages" />
    <!-- Markdown → HTML for the self-contained export (M13). Pure, UI-free. -->
    <PackageReference Include="Markdig" />
    <!-- HTML fragment → markdown for the block-HTML preview pass (tables/divs). Pure managed. -->
    <PackageReference Include="ReverseMarkdown" />
  </ItemGroup>

  <ItemGroup>
    <!-- Tests may pin internal seams (fragment markers, pass internals) without making them API. -->
    <InternalsVisibleTo Include="Tittle.Tests" />
  </ItemGroup>

</Project>
